@page "/boards/{BoardId:guid}/agents"
@using AgentTaskHarness.Application.Agents
@using AgentTaskHarness.Application.Boards
@using AgentTaskHarness.Domain.Entities
@using AgentTaskHarness.Domain.Enums
@inject BoardService BoardService
@inject AgentDefinitionService AgentDefinitionService
@inject AgentMatchingService AgentMatchingService
@inject NavigationManager Navigation

<PageTitle>Agent definitions</PageTitle>

<section class="page-intro compact-intro">
    <div><p class="breadcrumb"><a href="@($"/boards/{BoardId}")">Board</a> <span>/</span> Settings</p><h1>Agent definitions</h1><p>Compose reusable instructions and assign them to the workflow.</p></div>
    <div class="header-actions"><button class="button-quiet" @onclick="OpenComponentCreator">New component</button><button class="button-primary" @onclick="OpenDefinitionCreator">New definition</button></div>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="toast" role="alert" @key="messageVersion"><span>@message</span><button class="icon-button" type="button" aria-label="Dismiss notification" @onclick="DismissMessage">×</button></div>
}

<section class="definition-panel">
    <div class="section-heading"><div><p class="eyebrow">Building blocks</p><h2>Reusable components</h2></div><span class="tag">@availableComponents.Count total</span></div>
    @if (availableComponents.Count > 0)
    {
        <ul class="component-list">
            @foreach (var component in availableComponents)
            {
                <li><strong>@component.Name</strong><span>@component.ConfigContent</span></li>
            }
        </ul>
    }
    else
    {
        <p class="muted-copy">Create components for instructions, guardrails, or tool configuration.</p>
    }
</section>

@if (definitions.Count == 0)
{
    <section class="empty-state"><p class="eyebrow">No definitions yet</p><h2>Build an agent</h2><p>Combine reusable components into a definition that can be assigned to a column.</p><button class="button-primary" @onclick="OpenDefinitionCreator">Create definition</button></section>
}
else
{
    <section class="definition-panel definition-list-panel">
        <div class="section-heading"><div><p class="eyebrow">Compositions</p><h2>Definitions</h2></div></div>
        <div class="definition-list">
            @foreach (var definition in definitions)
            {
                <article><div><h3>@definition.Name</h3><p>@definition.FolderPath</p></div><button class="button-quiet" @onclick="() => SelectDefinitionAsync(definition.Id)">Edit</button></article>
            }
        </div>
    </section>

    <section class="definition-panel assignment-panel">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Workflow Assignment</p>
                <h2>Column assignments</h2>
            </div>
            <button class="button-primary" @onclick="() => OpenAssignmentCreator()">Assign agent</button>
        </div>
        <p class="muted-copy">Assign agent definitions to eligible column scopes with optional matching criteria (e.g. <code>rework=true</code>, <code>rework=false</code>, or keywords). Feature Build is never assignable.</p>

        <div class="scope-grid">
            @foreach (var scope in EligibleScopes)
            {
                var scopeAssignments = assignments.Where(a => a.ColumnScope == scope).ToList();
                <div class="scope-card">
                    <div class="scope-card-header">
                        <div>
                            <h3>@GetScopeDisplayName(scope)</h3>
                            <p class="muted-copy"><small>@GetScopeDescription(scope)</small></p>
                        </div>
                        <button class="button-quiet button-small" @onclick="() => OpenAssignmentCreator(scope)">+ Assign</button>
                    </div>
                    @if (scopeAssignments.Count > 0)
                    {
                        <ul class="assignment-list">
                            @foreach (var assignment in scopeAssignments)
                            {
                                <li class="assignment-item">
                                    <div class="assignment-details">
                                        <strong>@(assignment.AgentDefinition?.Name ?? "Agent")</strong>
                                        @if (!string.IsNullOrWhiteSpace(assignment.MatchCriteria))
                                        {
                                            <span class="criteria-badge" title="Match criteria">@assignment.MatchCriteria</span>
                                        }
                                        else
                                        {
                                            <span class="criteria-badge default-criteria" title="Default catch-all for any card">Default (all cards)</span>
                                        }
                                    </div>
                                    <div class="assignment-item-actions">
                                        <button class="button-quiet button-small" @onclick="() => OpenAssignmentEditor(assignment)">Edit</button>
                                        <button class="button-danger button-small" @onclick="() => DeleteAssignmentAsync(assignment.Id)">Remove</button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="empty-scope"><small>No agents assigned to this column scope.</small></p>
                    }
                </div>
            }
        </div>
    </section>
}

@if (isCreatingComponent)
{
    <div class="modal-backdrop" role="presentation"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="new-component-title"><div class="modal-heading"><div><p class="eyebrow">Building block</p><h2 id="new-component-title">New component</h2></div><button class="icon-button" type="button" aria-label="Close" @onclick="CloseComponentCreator">×</button></div><form class="form-panel" @onsubmit="CreateComponentAsync" @onsubmit:preventDefault><label>Name <input @bind="newComponentName" placeholder="Repository conventions" /></label><label>Configuration <textarea @bind="newComponentConfig" placeholder="Add the component content."></textarea></label><div class="modal-actions"><button class="button-quiet" type="button" @onclick="CloseComponentCreator">Cancel</button><button class="button-primary" type="submit">Create component</button></div></form></section></div>
}

@if (isCreatingDefinition)
{
    <div class="modal-backdrop" role="presentation"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="new-definition-title"><div class="modal-heading"><div><p class="eyebrow">Agent composition</p><h2 id="new-definition-title">New definition</h2></div><button class="icon-button" type="button" aria-label="Close" @onclick="CloseDefinitionCreator">×</button></div><form class="form-panel" @onsubmit="CreateDefinitionAsync" @onsubmit:preventDefault><label>Name <input @bind="newDefinitionName" placeholder="Implementation agent" /></label><div class="field-group"><label for="new-definition-folder">Definition folder</label><div class="path-input"><input id="new-definition-folder" @bind="newDefinitionFolderPath" placeholder="/path/to/definition" /><FolderPicker OnFolderSelected="path => newDefinitionFolderPath = path" /></div><small>Choose a folder to fill this field. Browsers hide its full local path, so replace the name with the server-visible path when needed.</small></div><div class="modal-actions"><button class="button-quiet" type="button" @onclick="CloseDefinitionCreator">Cancel</button><button class="button-primary" type="submit">Create definition</button></div></form></section></div>
}

@if (selectedDefinition is not null && isEditingDefinition)
{
    <div class="modal-backdrop" role="presentation"><section class="modal" role="dialog" aria-modal="true" aria-labelledby="edit-definition-title"><div class="modal-heading"><div><p class="eyebrow">Agent composition</p><h2 id="edit-definition-title">Edit @selectedDefinition.Name</h2></div><button class="icon-button" type="button" aria-label="Close" @onclick="CloseDefinitionEditor">×</button></div><form @onsubmit="SaveAsync" @onsubmit:preventDefault><div class="form-panel"><label>Name <input @bind="definitionName" /></label><div class="field-group"><label for="definition-folder">Definition folder</label><div class="path-input"><input id="definition-folder" @bind="definitionFolderPath" placeholder="/path/to/definition" /><FolderPicker OnFolderSelected="path => definitionFolderPath = path" /></div><small>Choose a folder to fill this field. Browsers hide its full local path, so replace the name with the server-visible path when needed.</small></div><label>Component
            <select @bind="componentToAdd">
                <option value="">Select a component…</option>
                @foreach (var component in availableComponents.Where(component => selectedComponents.All(selected => selected.Id != component.Id)))
                {
                    <option value="@component.Id">@component.Name</option>
                }
            </select>
        </label>
        <button class="button-quiet" type="button" @onclick="AddComponent">Add component</button></div>

        <section class="composition-editor"><h3>Composition order</h3>
        @if (selectedComponents.Count == 0)
        {
            <p class="muted-copy">No components selected.</p>
        }
        else
        {
            <ol class="composition-list">
                @for (var index = 0; index < selectedComponents.Count; index++)
                {
                    var component = selectedComponents[index];
                    <li>
                        <strong>@component.Name</strong>
                        <button class="button-quiet" type="button" @onclick="() => MoveComponent(index, -1)" disabled="@(index == 0)">Earlier</button>
                        <button class="button-quiet" type="button" @onclick="() => MoveComponent(index, 1)" disabled="@(index == selectedComponents.Count - 1)">Later</button>
                        <button class="button-danger" type="button" @onclick="() => RemoveComponent(component.Id)">Remove</button>
                    </li>
                }
            </ol>
        }
        </section><div class="modal-actions"><button class="button-danger" type="button" @onclick="DeleteDefinitionAsync">Delete definition</button><span class="modal-action-spacer"></span><button class="button-quiet" type="button" @onclick="CloseDefinitionEditor">Cancel</button><button class="button-primary" type="submit">Save definition</button></div></form></section></div>
}

@if (isManagingAssignment)
{
    <div class="modal-backdrop" role="presentation">
        <section class="modal" role="dialog" aria-modal="true" aria-labelledby="assignment-modal-title">
            <div class="modal-heading">
                <div>
                    <p class="eyebrow">Workflow Assignment</p>
                    <h2 id="assignment-modal-title">@(editingAssignment is null ? "Assign agent to column" : "Edit column assignment")</h2>
                </div>
                <button class="icon-button" type="button" aria-label="Close" @onclick="CloseAssignmentModal">×</button>
            </div>
            <form class="form-panel" @onsubmit="SaveAssignmentAsync" @onsubmit:preventDefault>
                @if (editingAssignment is null)
                {
                    <label>
                        Column Scope
                        <select @bind="selectedScope">
                            @foreach (var scope in EligibleScopes)
                            {
                                <option value="@scope">@GetScopeDisplayName(scope)</option>
                            }
                        </select>
                    </label>
                }
                else
                {
                    <div>
                        <span class="eyebrow">Column Scope</span>
                        <p><strong>@GetScopeDisplayName(selectedScope)</strong></p>
                    </div>
                }

                <label>
                    Agent Definition
                    <select @bind="selectedAgentDefinitionId">
                        <option value="@Guid.Empty">Select a definition…</option>
                        @foreach (var definition in definitions)
                        {
                            <option value="@definition.Id">@definition.Name</option>
                        }
                    </select>
                </label>

                <label>
                    Match Criteria
                    <input @bind="matchCriteriaInput" placeholder="e.g. rework=true, rework=false, or leave blank for default" />
                    <small class="muted-copy">
                        Optional. Leave blank to match all cards unconditionally. Specify rules like <code>rework=true</code>, <code>rework=false</code>, or keywords to target specific cards.
                    </small>
                </label>

                <div class="modal-actions">
                    @if (editingAssignment is not null)
                    {
                        <button class="button-danger" type="button" @onclick="() => DeleteAssignmentAsync(editingAssignment.Id)">Delete assignment</button>
                        <span class="modal-action-spacer"></span>
                    }
                    <button class="button-quiet" type="button" @onclick="CloseAssignmentModal">Cancel</button>
                    <button class="button-primary" type="submit" disabled="@(selectedAgentDefinitionId == Guid.Empty)">
                        @(editingAssignment is null ? "Assign" : "Save changes")
                    </button>
                </div>
            </form>
        </section>
    </div>
}

@code {
    [Parameter] public Guid BoardId { get; set; }

    private static readonly ColumnScope[] EligibleScopes = [
        ColumnScope.StepBuild,
        ColumnScope.StepAgentReview,
        ColumnScope.FeatureAgentReview
    ];

    private List<AgentDefinition> definitions = [];
    private List<AgentComponent> availableComponents = [];
    private List<AgentColumnAssignment> assignments = [];
    private AgentDefinition? selectedDefinition;
    private List<AgentComponent> selectedComponents = [];
    private string newComponentName = string.Empty;
    private string newComponentConfig = string.Empty;
    private string newDefinitionName = string.Empty;
    private string newDefinitionFolderPath = string.Empty;
    private string definitionName = string.Empty;
    private string definitionFolderPath = string.Empty;
    private Guid? componentToAdd;
    private string? message;
    private int messageVersion;
    private bool isCreatingComponent;
    private bool isCreatingDefinition;
    private bool isEditingDefinition;

    private bool isManagingAssignment;
    private AgentColumnAssignment? editingAssignment;
    private ColumnScope selectedScope = ColumnScope.StepBuild;
    private Guid selectedAgentDefinitionId;
    private string matchCriteriaInput = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (await BoardService.GetByIdAsync(BoardId) is null)
        {
            Navigation.NavigateTo("/boards");
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        definitions = await AgentDefinitionService.GetForBoardAsync(BoardId);
        availableComponents = await AgentDefinitionService.GetComponentsAsync();
        assignments = await AgentMatchingService.GetAssignmentsAsync(BoardId);
        if (selectedDefinition is not null)
        {
            await SelectDefinitionAsync(selectedDefinition.Id);
        }
    }

    private static string GetScopeDisplayName(ColumnScope scope) => scope switch
    {
        ColumnScope.StepBuild => "Step: Build",
        ColumnScope.StepAgentReview => "Step: Agent Review",
        ColumnScope.FeatureAgentReview => "Feature: Agent Review",
        _ => scope.ToString()
    };

    private static string GetScopeDescription(ColumnScope scope) => scope switch
    {
        ColumnScope.StepBuild => "Runs when a dev plan step begins active implementation.",
        ColumnScope.StepAgentReview => "Runs when a step is submitted for automated review.",
        ColumnScope.FeatureAgentReview => "Runs when all steps complete and the feature enters review.",
        _ => string.Empty
    };

    private void OpenAssignmentCreator(ColumnScope? scope = null)
    {
        editingAssignment = null;
        selectedScope = scope ?? ColumnScope.StepBuild;
        selectedAgentDefinitionId = definitions.FirstOrDefault()?.Id ?? Guid.Empty;
        matchCriteriaInput = string.Empty;
        isManagingAssignment = true;
    }

    private void OpenAssignmentEditor(AgentColumnAssignment assignment)
    {
        editingAssignment = assignment;
        selectedScope = assignment.ColumnScope;
        selectedAgentDefinitionId = assignment.AgentDefinitionId;
        matchCriteriaInput = assignment.MatchCriteria;
        isManagingAssignment = true;
    }

    private void CloseAssignmentModal()
    {
        isManagingAssignment = false;
        editingAssignment = null;
    }

    private async Task SaveAssignmentAsync()
    {
        if (selectedAgentDefinitionId == Guid.Empty)
        {
            ShowMessage("Please select an agent definition.");
            return;
        }

        try
        {
            if (editingAssignment is null)
            {
                await AgentMatchingService.AssignAgentAsync(BoardId, selectedScope, selectedAgentDefinitionId, matchCriteriaInput);
            }
            else
            {
                await AgentMatchingService.UpdateAssignmentAsync(editingAssignment.Id, selectedAgentDefinitionId, matchCriteriaInput);
            }
            CloseAssignmentModal();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private async Task DeleteAssignmentAsync(Guid assignmentId)
    {
        try
        {
            await AgentMatchingService.DeleteAssignmentAsync(assignmentId);
            if (editingAssignment?.Id == assignmentId)
            {
                CloseAssignmentModal();
            }
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private async Task CreateComponentAsync()
    {
        try
        {
            await AgentDefinitionService.CreateComponentAsync(newComponentName, newComponentConfig);
            newComponentName = string.Empty;
            newComponentConfig = string.Empty;
            CloseComponentCreator();
            availableComponents = await AgentDefinitionService.GetComponentsAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private async Task CreateDefinitionAsync()
    {
        try
        {
            await AgentDefinitionService.CreateAsync(BoardId, newDefinitionName, newDefinitionFolderPath);
            newDefinitionName = string.Empty;
            newDefinitionFolderPath = string.Empty;
            CloseDefinitionCreator();
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private async Task SelectDefinitionAsync(Guid definitionId)
    {
        selectedDefinition = await AgentDefinitionService.GetByIdAsync(definitionId);
        if (selectedDefinition is null)
        {
            return;
        }
        definitionName = selectedDefinition.Name;
        definitionFolderPath = selectedDefinition.FolderPath;
        selectedComponents = selectedDefinition.Components.OrderBy(component => component.Order).Select(component => component.Component).ToList();
        componentToAdd = null;
        isEditingDefinition = true;
    }

    private void AddComponent()
    {
        if (componentToAdd is not Guid componentId)
        {
            return;
        }
        var component = availableComponents.Single(component => component.Id == componentId);
        selectedComponents.Add(component);
        componentToAdd = null;
    }

    private void MoveComponent(int index, int direction)
    {
        if (index + direction < 0 || index + direction >= selectedComponents.Count)
        {
            return;
        }
        (selectedComponents[index], selectedComponents[index + direction]) = (selectedComponents[index + direction], selectedComponents[index]);
    }

    private void RemoveComponent(Guid componentId) => selectedComponents.RemoveAll(component => component.Id == componentId);

    private async Task SaveAsync()
    {
        if (selectedDefinition is null)
        {
            return;
        }
        try
        {
            await AgentDefinitionService.SaveAsync(selectedDefinition.Id, definitionName, definitionFolderPath, selectedComponents.Select(component => component.Id).ToList());
            await LoadAsync();
            CloseDefinitionEditor();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private async Task DeleteDefinitionAsync()
    {
        if (selectedDefinition is null)
        {
            return;
        }
        try
        {
            await AgentDefinitionService.DeleteAsync(selectedDefinition.Id);
            selectedDefinition = null;
            selectedComponents = [];
            CloseDefinitionEditor();
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private void OpenComponentCreator() => isCreatingComponent = true;

    private void CloseComponentCreator() => isCreatingComponent = false;

    private void OpenDefinitionCreator() => isCreatingDefinition = true;

    private void CloseDefinitionCreator() => isCreatingDefinition = false;

    private void CloseDefinitionEditor() => isEditingDefinition = false;

    private void ShowMessage(string text)
    {
        message = text;
        messageVersion++;
    }

    private void DismissMessage() => message = null;
}
