@page "/agents"
@page "/agents/{AgentId:guid}"
@inject AgentDefinitionService AgentDefinitionService

<PageTitle>Agent definitions</PageTitle>

<PageTemplate Title="Agent definitions" Eyebrow="Agents"
              Description="Compose reusable instructions and assign them to the workflow.">
    <Actions>
        <button
            class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            @onclick="OpenComponentCreator">New component
        </button>
        <button
            class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            @onclick="OpenDefinitionCreator">New definition
        </button>
    </Actions>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <div
                class="fixed right-6 top-6 z-30 flex max-w-lg items-center justify-between gap-3 rounded-lg border-[3px] border-amber-300 bg-amber-50 px-4 py-2 text-amber-900 shadow-lg"
                role="alert" @key="_messageVersion"><span>@_message</span>
                <button
                    class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                    type="button" aria-label="Dismiss notification" @onclick="DismissMessage">×
                </button>
            </div>
        }

        <section class="mt-4 max-w-5xl rounded-xl border-[3px] border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex items-start justify-between">
                <div><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Building blocks</p>
                    <h2>Reusable components</h2></div>
                <span
                    class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold uppercase tracking-wide text-slate-600">@_availableComponents.Count total</span>
            </div>
            @if (_availableComponents.Count > 0)
            {
                <ul class="mt-4 grid list-none gap-2 p-0">
                    @foreach (var component in _availableComponents)
                    {
                        <li class="grid gap-1 rounded-lg bg-slate-100 p-3"><strong
                                class="text-slate-900">@component.Name</strong><span
                                class="whitespace-pre-wrap text-sm leading-6 text-slate-600">@component.ConfigContent</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-sm leading-6 text-slate-500">Create components for instructions, guardrails, or tool
                    configuration.</p>
            }
        </section>

        @if (_definitions.Count == 0)
        {
            <section class="empty-state"><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">
                    No definitions yet</p>
                <h2>Build an agent</h2>
                <p>Combine reusable components into a definition that can be assigned to a column.</p>
                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                        @onclick="OpenDefinitionCreator">Create definition
                </button>
            </section>
        }
        else
        {
            <section class="mt-4 max-w-5xl rounded-xl border-[3px] border-slate-200 bg-white p-5 shadow-sm">
                <div class="flex items-start justify-between">
                    <div><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Compositions</p>
                        <h2>Definitions</h2></div>
                </div>
                <div class="mt-4 grid gap-3">
                    @foreach (var definition in _definitions)
                    {
                        <article
                            class="flex flex-col justify-between gap-3 rounded-lg border-[3px] border-slate-200 p-3 sm:flex-row sm:items-center">
                            <div><h3 class="font-semibold text-slate-900">@definition.Name</h3>
                                <p class="text-sm leading-6 text-slate-500">Database-backed configuration</p></div>
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                @onclick="() => SelectDefinitionAsync(definition.Id)">Edit
                            </button>
                        </article>
                    }
                </div>
            </section>

            @if (false)
            {
            }
        }

        @if (_isCreatingComponent)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm"
                 role="presentation">
                <section
                    class="max-h-[calc(100vh-2rem)] w-full max-w-xl overflow-y-auto rounded-xl border-[3px] border-slate-200 bg-white p-6 shadow-2xl"
                    role="dialog" aria-modal="true" aria-labelledby="new-component-title">
                    <div class="mb-5 flex items-start justify-between">
                        <div><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Building
                                block</p>
                            <h2 id="new-component-title">New component</h2></div>
                        <button
                            class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                            type="button" aria-label="Close" @onclick="CloseComponentCreator">×
                        </button>
                    </div>
                    <form class="grid gap-4" @onsubmit="CreateComponentAsync" @onsubmit:preventDefault><label>Name
                            <input
                                @bind="_newComponentName" placeholder="Repository conventions"/></label><label>Configuration
                            <textarea @bind="_newComponentConfig"
                                      placeholder="Add the component content."></textarea></label>
                        <div class="mt-5 flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 pt-4">
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="button" @onclick="CloseComponentCreator">Cancel
                            </button>
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="submit">Create component
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        }

        @if (_isEditingComponent && _editingComponent is not null)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm"
                 role="presentation">
                <section
                    class="max-h-[calc(100vh-2rem)] w-full max-w-xl overflow-y-auto rounded-xl border-[3px] border-slate-200 bg-white p-6 shadow-2xl"
                    role="dialog" aria-modal="true" aria-labelledby="edit-component-title">
                    <div class="mb-5 flex items-start justify-between"><h2 id="edit-component-title">Edit component</h2>
                        <button
                            class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                            type="button" aria-label="Close" @onclick="CloseComponentEditor">×
                        </button>
                    </div>
                    <form class="grid gap-4" @onsubmit="UpdateComponentAsync" @onsubmit:preventDefault>
                        <label>Name <input @bind="_editingComponentName"/></label>
                        <label>Configuration <textarea @bind="_editingComponentConfig"></textarea></label>
                        <div class="mt-5 flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 pt-4">
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="button" @onclick="CloseComponentEditor">Cancel
                            </button>
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="submit">Save component
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        }

        @if (_isCreatingDefinition)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm"
                 role="presentation">
                <section
                    class="max-h-[calc(100vh-2rem)] w-full max-w-xl overflow-y-auto rounded-xl border-[3px] border-slate-200 bg-white p-6 shadow-2xl"
                    role="dialog" aria-modal="true" aria-labelledby="new-definition-title">
                    <div class="mb-5 flex items-start justify-between">
                        <div><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Agent
                                composition</p>
                            <h2 id="new-definition-title">New definition</h2></div>
                        <button
                            class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                            type="button" aria-label="Close" @onclick="CloseDefinitionCreator">×
                        </button>
                    </div>
                    <form class="grid gap-4" @onsubmit="CreateDefinitionAsync" @onsubmit:preventDefault><label>Name
                            <input
                                @bind="_newDefinitionName" placeholder="Implementation agent"/></label>
                        <label>Prompt <textarea @bind="_newDefinitionPrompt"
                                                placeholder="Primary agent prompt"></textarea></label>
                        <label>Instructions <textarea @bind="_newDefinitionInstructions"
                                                      placeholder="Instructions and guardrails"></textarea></label>
                        <label>Tool configuration <textarea @bind="_newDefinitionTools"
                                                            placeholder="JSON or CLI tool configuration"></textarea></label>
                        <div class="mt-5 flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 pt-4">
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="button" @onclick="CloseDefinitionCreator">Cancel
                            </button>
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="submit">Create definition
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        }

        @if (_selectedDefinition is not null && _isEditingDefinition)
        {
            <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm"
                 role="presentation">
                <section
                    class="max-h-[calc(100vh-2rem)] w-full max-w-xl overflow-y-auto rounded-xl border-[3px] border-slate-200 bg-white p-6 shadow-2xl"
                    role="dialog" aria-modal="true" aria-labelledby="edit-definition-title">
                    <div class="mb-5 flex items-start justify-between">
                        <div><p class="mb-1 text-xs font-semibold uppercase tracking-wider text-slate-500">Agent
                                composition</p>
                            <h2 id="edit-definition-title">Edit @_selectedDefinition.Name</h2></div>
                        <button
                            class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
                            type="button" aria-label="Close" @onclick="CloseDefinitionEditor">×
                        </button>
                    </div>
                    <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
                        <div class="grid gap-4"><label>Name <input @bind="_definitionName"/></label>
                            <label>Prompt <textarea @bind="_definitionPrompt"></textarea></label>
                            <label>Instructions <textarea @bind="_definitionInstructions"></textarea></label>
                            <label>Tool configuration <textarea @bind="_definitionTools"></textarea></label>
                            <label>Component
                                <select @bind="_componentToAdd">
                                    <option value="">Select a component…</option>
                                    @foreach (var component in _availableComponents.Where(component => _selectedComponents.All(selected => selected.Id != component.Id)))
                                    {
                                        <option value="@component.Id">@component.Name</option>
                                    }
                                </select>
                            </label>
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="button" @onclick="AddComponent">Add component
                            </button>
                        </div>

                        <section class="mt-5"><h3>Composition order</h3>
                            @if (_selectedComponents.Count == 0)
                            {
                                <p class="text-sm leading-6 text-slate-500">No components selected.</p>
                            }
                            else
                            {
                                <ol class="mt-3 grid list-none gap-2 p-0">
                                    @for (var index = 0; index < _selectedComponents.Count; index++)
                                    {
                                        var component = _selectedComponents[index];
                                        <li>
                                            <strong>@component.Name</strong>
                                            <button
                                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 text-xs"
                                                type="button"
                                                @onclick="() => OpenComponentEditor(component)">Edit
                                            </button>
                                            <button
                                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                                type="button" @onclick="() => MoveComponent(index, -1)"
                                                disabled="@(index == 0)">Earlier
                                            </button>
                                            <button
                                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                                type="button" @onclick="() => MoveComponent(index, 1)"
                                                disabled="@(index == _selectedComponents.Count - 1)">Later
                                            </button>
                                            <button
                                                class="inline-flex items-center justify-center rounded-md border-[3px] border-red-600 bg-red-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-red-700 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                                type="button"
                                                @onclick="() => RemoveComponent(component.Id)">Remove
                                            </button>
                                        </li>
                                    }
                                </ol>
                            }
                        </section>
                        <div class="mt-5 flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 pt-4">
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-red-600 bg-red-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-red-700 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="button" @onclick="DeleteDefinitionAsync">Delete definition
                            </button>
                            <span class="flex-1"></span>
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="button" @onclick="CloseDefinitionEditor">Cancel
                            </button>
                            <button
                                class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                type="submit">Save definition
                            </button>
                        </div>
                    </form>
                </section>
            </div>
        }
    </ChildContent>
</PageTemplate>

@code {
    [Parameter] public Guid AgentId { get; set; }
    private List<AgentDefinition> _definitions = [];
    private List<AgentComponent> _availableComponents = [];
    private AgentDefinition? _selectedDefinition;
    private List<AgentComponent> _selectedComponents = [];
    private string _newComponentName = string.Empty;
    private string _newComponentConfig = string.Empty;
    private string _newDefinitionName = string.Empty;
    private string _newDefinitionPrompt = string.Empty;
    private string _newDefinitionInstructions = string.Empty;
    private string _newDefinitionTools = string.Empty;
    private string _definitionName = string.Empty;
    private string _definitionPrompt = string.Empty;
    private string _definitionInstructions = string.Empty;
    private string _definitionTools = string.Empty;
    private AgentComponent? _editingComponent;
    private string _editingComponentName = string.Empty;
    private string _editingComponentConfig = string.Empty;
    private bool _isEditingComponent;
    private Guid? _componentToAdd;
    private string? _message;
    private int _messageVersion;
    private bool _isCreatingComponent;
    private bool _isCreatingDefinition;
    private bool _isEditingDefinition;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        if (AgentId != Guid.Empty && _definitions.Any(definition => definition.Id == AgentId))
            await SelectDefinitionAsync(AgentId);
    }

    private async Task LoadAsync()
    {
        _definitions = await AgentDefinitionService.GetAllAsync();
        _availableComponents = await AgentDefinitionService.GetComponentsAsync();
        if (_selectedDefinition is not null)
            await SelectDefinitionAsync(_selectedDefinition.Id);
    }

    private async Task CreateComponentAsync()
    {
        try
        {
            await AgentDefinitionService.CreateComponentAsync(_newComponentName, _newComponentConfig);
            _newComponentName = string.Empty;
            _newComponentConfig = string.Empty;
            CloseComponentCreator();
            _availableComponents = await AgentDefinitionService.GetComponentsAsync();
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private async Task CreateDefinitionAsync()
    {
        try
        {
            await AgentDefinitionService.CreateAsync(_newDefinitionName, _newDefinitionPrompt,
                _newDefinitionInstructions, _newDefinitionTools);
            _newDefinitionName = string.Empty;
            _newDefinitionPrompt = string.Empty;
            _newDefinitionInstructions = string.Empty;
            _newDefinitionTools = string.Empty;
            CloseDefinitionCreator();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private async Task SelectDefinitionAsync(Guid definitionId)
    {
        _selectedDefinition = await AgentDefinitionService.GetByIdAsync(definitionId);
        if (_selectedDefinition is null)
        {
            return;
        }

        _definitionName = _selectedDefinition.Name;
        _definitionPrompt = _selectedDefinition.Prompt;
        _definitionInstructions = _selectedDefinition.Instructions;
        _definitionTools = _selectedDefinition.ToolConfiguration;
        _selectedComponents = _selectedDefinition.Components.OrderBy(component => component.Order).Select(component => component.Component).ToList();
        _componentToAdd = null;
        _isEditingDefinition = true;
    }

    private void AddComponent()
    {
        if (_componentToAdd is not Guid componentId)
        {
            return;
        }

        var component = _availableComponents.Single(component => component.Id == componentId);
        _selectedComponents.Add(component);
        _componentToAdd = null;
    }

    private void MoveComponent(int index, int direction)
    {
        if (index + direction < 0 || index + direction >= _selectedComponents.Count)
        {
            return;
        }

        (_selectedComponents[index], _selectedComponents[index + direction]) = (_selectedComponents[index + direction], _selectedComponents[index]);
    }

    private void RemoveComponent(Guid componentId)
    {
        _selectedComponents.RemoveAll(component => component.Id == componentId);
    }

    private async Task SaveAsync()
    {
        if (_selectedDefinition is null)
        {
            return;
        }

        try
        {
            await AgentDefinitionService.SaveAsync(_selectedDefinition.Id, _definitionName, _definitionPrompt,
                _definitionInstructions, _definitionTools, _selectedComponents.Select(component => component.Id).ToList());
            await LoadAsync();
            CloseDefinitionEditor();
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private async Task DeleteDefinitionAsync()
    {
        if (_selectedDefinition is null)
        {
            return;
        }

        try
        {
            await AgentDefinitionService.DeleteAsync(_selectedDefinition.Id);
            _selectedDefinition = null;
            _selectedComponents = [];
            CloseDefinitionEditor();
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private void OpenComponentCreator()
    {
        _isCreatingComponent = true;
    }

    private void OpenComponentEditor(AgentComponent component)
    {
        _editingComponent = component;
        _editingComponentName = component.Name;
        _editingComponentConfig = component.ConfigContent;
        _isEditingComponent = true;
    }

    private void CloseComponentEditor()
    {
        _isEditingComponent = false;
        _editingComponent = null;
    }

    private async Task UpdateComponentAsync()
    {
        if (_editingComponent is null) return;
        try
        {
            await AgentDefinitionService.UpdateComponentAsync(_editingComponent.Id, _editingComponentName,
                _editingComponentConfig);
            CloseComponentEditor();
            _availableComponents = await AgentDefinitionService.GetComponentsAsync();
            if (_selectedDefinition is not null) await SelectDefinitionAsync(_selectedDefinition.Id);
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private void CloseComponentCreator()
    {
        _isCreatingComponent = false;
    }

    private void OpenDefinitionCreator()
    {
        _isCreatingDefinition = true;
    }

    private void CloseDefinitionCreator()
    {
        _isCreatingDefinition = false;
    }

    private void CloseDefinitionEditor()
    {
        _isEditingDefinition = false;
    }

    private void ShowMessage(string text)
    {
        _message = text;
        _messageVersion++;
    }

    private void DismissMessage()
    {
        _message = null;
    }

}
