@page "/boards/{BoardId:guid}"
@using AgentTaskHarness.Application.Boards
@using AgentTaskHarness.Application.Comments
@using AgentTaskHarness.Application.Features
@using AgentTaskHarness.Application.Reviews
@using AgentTaskHarness.Application.Steps
@using AgentTaskHarness.Domain.Entities
@using AgentTaskHarness.Domain.Enums
@inject BoardService BoardService
@inject FeatureService FeatureService
@inject StepService StepService
@inject FeatureTransitionOrchestrator FeatureOrchestrator
@inject StepTransitionOrchestrator StepOrchestrator
@inject CommentService CommentService
@inject ReviewOutcomeService ReviewOutcomeService
@inject NavigationManager Navigation

<PageTitle>@(board?.Name ?? "Board")</PageTitle>

@if (board is null)
{
    <p>Loading board…</p>
}
else
{
    <section class="board-header">
        <div>
            <p class="breadcrumb"><a href="/boards">Boards</a> <span>/</span> @board.Name</p>
            <h1>@board.Name</h1>
            <div class="board-settings-summary">
                <span class="tag">Feature Human Review: @(board.SkipFeatureHumanReview ? "Skipped" : "Required")</span>
                <span class="tag">Step Human Review: @(board.SkipStepHumanReview ? "Skipped" : "Required")</span>
                <span class="tag">Agent Fail Limit: @board.AgentReviewFailThreshold</span>
                <span class="tag">Human Fail Limit: @board.HumanReviewFailThreshold</span>
            </div>
        </div>
        <div class="header-actions">
            <a class="button-quiet" href="@($"/boards/{BoardId}/agents")">Agents</a>
            <button class="button-quiet" @onclick="OpenBoardEditor">Board settings</button>
            <button class="button-primary" @onclick="OpenFeatureCreator">New feature</button>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="toast" role="alert" @key="messageVersion"><span>@message</span><button class="icon-button" type="button" aria-label="Dismiss notification" @onclick="DismissMessage">×</button></div>
    }

    <div class="board-grid">
        @foreach (var column in Enum.GetValues<WorkflowColumn>())
        {
            <section class="column">
                <div class="column-heading"><h2>@column</h2></div>
                @foreach (var feature in features.Where(f => f.WorkflowColumn == column))
                {
                    <article class="task-card">
                        <div>
                            <h3>@feature.Title</h3>
                            <p>@feature.Requirements</p>
                            <div class="card-tags">
                                <small class="muted-copy">Steps: @feature.Steps.Count</small>
                                @if (ReviewOutcomeService.IsRework(feature))
                                {
                                    <span class="tag tag-rework">Rework</span>
                                }
                                @if (ReviewOutcomeService.HasIssue(feature, board))
                                {
                                    <span class="tag tag-issue">Issue: Threshold Reached</span>
                                }
                                @if (feature.AlwaysRequireHumanReview)
                                {
                                    <span class="tag">Always Human Review</span>
                                }
                                @if (feature.AgentReviewFailCount > 0 || feature.HumanReviewFailCount > 0)
                                {
                                    <small class="muted-copy">Fails: Agent @feature.AgentReviewFailCount | Human @feature.HumanReviewFailCount</small>
                                }
                            </div>
                        </div>

                        @if (featureAllowedMoves.TryGetValue(feature.Id, out var fMoves) && fMoves.Count > 0)
                        {
                            <div class="move-actions">
                                <span class="move-label">Move:</span>
                                @foreach (var target in fMoves)
                                {
                                    <button class="button-move" @onclick="() => MoveFeatureAsync(feature.Id, target)">→ @target</button>
                                }
                            </div>
                        }

                        <div class="card-actions">
                            <button class="button-quiet" @onclick="() => StartEditingFeature(feature)">Edit</button>
                            <button class="button-quiet" @onclick="() => OpenStepCreator(feature.Id)">Add step</button>
                            <button class="button-quiet" @onclick="() => ToggleCommentsAsync(CardType.Feature, feature.Id)">Comments (@GetCommentCount(CardType.Feature, feature.Id))</button>
                            <button class="button-danger" @onclick="() => DeleteFeatureAsync(feature.Id)">Delete</button>
                        </div>

                        @if (activeCommentsCard == (CardType.Feature, feature.Id))
                        {
                            <div class="comments-panel">
                                <div class="comments-panel-header">
                                    <strong>Comments</strong>
                                    <button class="icon-button" type="button" aria-label="Close comments" @onclick="CloseComments">×</button>
                                </div>
                                <div class="comments-list">
                                    @if (loadedComments.TryGetValue((CardType.Feature, feature.Id), out var fComments) && fComments.Count > 0)
                                    {
                                        @foreach (var comment in fComments)
                                        {
                                            <div class="comment-item">
                                                <div class="comment-header">
                                                    <strong class="comment-author">@comment.Author</strong>
                                                    <span class="comment-time">@comment.CreatedAt.LocalDateTime.ToString("g")</span>
                                                </div>
                                                <p class="comment-body">@comment.Body</p>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="muted-copy"><small>No comments yet.</small></p>
                                    }
                                </div>
                                <form class="add-comment-form" @onsubmit="() => AddCommentAsync(CardType.Feature, feature.Id)" @onsubmit:preventDefault>
                                    <input class="comment-author-input" placeholder="Author" @bind="commentAuthor" />
                                    <textarea class="comment-body-input" placeholder="Write a comment…" @bind="commentBody"></textarea>
                                    <div class="comment-form-actions">
                                        <button class="button-primary button-small" type="submit">Post comment</button>
                                    </div>
                                </form>
                            </div>
                        }

                        @if (feature.Steps.Count > 0)
                        {
                            <div class="step-list">
                                @foreach (var step in feature.Steps)
                                {
                                    <div class="step-item">
                                        <div class="step-header">
                                            <strong>@step.Title</strong>
                                            <span class="status-pill">@step.WorkflowColumn</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(step.Description))
                                        {
                                            <p><small>@step.Description</small></p>
                                        }
                                        <div class="card-tags">
                                            @if (ReviewOutcomeService.IsRework(step))
                                            {
                                                <span class="tag tag-rework">Rework</span>
                                            }
                                            @if (ReviewOutcomeService.HasIssue(step, board))
                                            {
                                                <span class="tag tag-issue">Issue: Threshold Reached</span>
                                            }
                                            @if (step.AlwaysRequireHumanReview)
                                            {
                                                <span class="tag">Always Human Review</span>
                                            }
                                            @if (step.AgentReviewFailCount > 0 || step.HumanReviewFailCount > 0)
                                            {
                                                <small class="muted-copy">Fails: Agent @step.AgentReviewFailCount | Human @step.HumanReviewFailCount</small>
                                            }
                                        </div>
                                        @if (stepAllowedMoves.TryGetValue(step.Id, out var sMoves) && sMoves.Count > 0)
                                        {
                                            <div class="move-actions">
                                                <span class="move-label">Move:</span>
                                                @foreach (var target in sMoves)
                                                {
                                                    <button class="button-move" @onclick="() => MoveStepAsync(step.Id, target)">→ @target</button>
                                                }
                                            </div>
                                        }
                                        <div class="step-actions">
                                            <button class="button-quiet button-small" @onclick="() => StartEditingStep(step)">Edit</button>
                                            <button class="button-quiet button-small" @onclick="() => ToggleCommentsAsync(CardType.Step, step.Id)">Comments (@GetCommentCount(CardType.Step, step.Id))</button>
                                            <button class="button-danger button-small" @onclick="() => DeleteStepAsync(step.Id)">Delete</button>
                                        </div>

                                        @if (activeCommentsCard == (CardType.Step, step.Id))
                                        {
                                            <div class="comments-panel">
                                                <div class="comments-panel-header">
                                                    <strong>Step comments</strong>
                                                    <button class="icon-button" type="button" aria-label="Close comments" @onclick="CloseComments">×</button>
                                                </div>
                                                <div class="comments-list">
                                                    @if (loadedComments.TryGetValue((CardType.Step, step.Id), out var sComments) && sComments.Count > 0)
                                                    {
                                                        @foreach (var comment in sComments)
                                                        {
                                                            <div class="comment-item">
                                                                <div class="comment-header">
                                                                    <strong class="comment-author">@comment.Author</strong>
                                                                    <span class="comment-time">@comment.CreatedAt.LocalDateTime.ToString("g")</span>
                                                                </div>
                                                                <p class="comment-body">@comment.Body</p>
                                                            </div>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <p class="muted-copy"><small>No comments yet.</small></p>
                                                    }
                                                </div>
                                                <form class="add-comment-form" @onsubmit="() => AddCommentAsync(CardType.Step, step.Id)" @onsubmit:preventDefault>
                                                    <input class="comment-author-input" placeholder="Author" @bind="commentAuthor" />
                                                    <textarea class="comment-body-input" placeholder="Write a comment…" @bind="commentBody"></textarea>
                                                    <div class="comment-form-actions">
                                                        <button class="button-primary button-small" type="submit">Post comment</button>
                                                    </div>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </section>
        }
    </div>

    @if (isEditingBoard)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal" role="dialog" aria-modal="true" aria-labelledby="board-settings-title">
                <div class="modal-heading">
                    <div><p class="eyebrow">Workspace settings</p><h2 id="board-settings-title">Edit board</h2></div>
                    <button class="icon-button" type="button" aria-label="Close" @onclick="CloseBoardEditor">×</button>
                </div>
                <form class="form-panel" @onsubmit="SaveBoardAsync" @onsubmit:preventDefault>
                    <label>Name <input @bind="boardName" /></label>
                    <div class="field-group">
                        <label for="repository-path">Repository path</label>
                        <div class="path-input">
                            <input id="repository-path" @bind="repoPath" placeholder="/path/to/repository" />
                            <FolderPicker OnFolderSelected="path => repoPath = path" />
                        </div>
                    </div>
                    <label>Agent concurrency <input type="number" min="1" @bind="concurrencyLimit" /></label>
                    <label><input type="checkbox" @bind="skipFeatureHumanReview" /> Skip Feature Human Review</label>
                    <label><input type="checkbox" @bind="skipStepHumanReview" /> Skip Step Human Review</label>
                    <label>Agent Review Fail Threshold <input type="number" min="0" @bind="agentReviewFailThreshold" /></label>
                    <label>Human Review Fail Threshold <input type="number" min="0" @bind="humanReviewFailThreshold" /></label>
                    <div class="modal-actions">
                        <button class="button-quiet" type="button" @onclick="CloseBoardEditor">Cancel</button>
                        <button class="button-primary" type="submit">Save changes</button>
                    </div>
                </form>
            </section>
        </div>
    }

    @if (isCreatingFeature)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal" role="dialog" aria-modal="true" aria-labelledby="new-feature-title">
                <div class="modal-heading">
                    <div><p class="eyebrow">Backlog</p><h2 id="new-feature-title">Create feature</h2></div>
                    <button class="icon-button" type="button" aria-label="Close" @onclick="CloseFeatureCreator">×</button>
                </div>
                <form class="form-panel" @onsubmit="CreateFeatureAsync" @onsubmit:preventDefault>
                    <label>Title <input @bind="newFeatureTitle" placeholder="Feature title" /></label>
                    <label>Requirements <textarea @bind="newFeatureRequirements" placeholder="Requirements"></textarea></label>
                    <label>Acceptance Criteria <textarea @bind="newFeatureAcceptanceCriteria" placeholder="Acceptance criteria"></textarea></label>
                    <label>Suggested Solution <textarea @bind="newFeatureSuggestedSolution" placeholder="Suggested solution"></textarea></label>
                    <label><input type="checkbox" @bind="newFeatureAlwaysHumanReview" /> Always require Human Review</label>
                    <div class="modal-actions">
                        <button class="button-quiet" type="button" @onclick="CloseFeatureCreator">Cancel</button>
                        <button class="button-primary" type="submit">Create feature</button>
                    </div>
                </form>
            </section>
        </div>
    }

    @if (editingFeature is not null)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal" role="dialog" aria-modal="true" aria-labelledby="edit-feature-title">
                <div class="modal-heading">
                    <div><p class="eyebrow">Feature details</p><h2 id="edit-feature-title">Edit feature</h2></div>
                    <button class="icon-button" type="button" aria-label="Close" @onclick="CloseFeatureEditor">×</button>
                </div>
                <form class="form-panel" @onsubmit="SaveFeatureAsync" @onsubmit:preventDefault>
                    <label>Title <input @bind="editFeatureTitle" /></label>
                    <label>Requirements <textarea @bind="editFeatureRequirements"></textarea></label>
                    <label>Acceptance Criteria <textarea @bind="editFeatureAcceptanceCriteria"></textarea></label>
                    <label>Suggested Solution <textarea @bind="editFeatureSuggestedSolution"></textarea></label>
                    <label><input type="checkbox" @bind="editFeatureAlwaysHumanReview" /> Always require Human Review</label>
                    <div class="modal-actions">
                        <button class="button-quiet" type="button" @onclick="CloseFeatureEditor">Cancel</button>
                        <button class="button-primary" type="submit">Save changes</button>
                    </div>
                </form>
            </section>
        </div>
    }

    @if (isCreatingStep)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal" role="dialog" aria-modal="true" aria-labelledby="new-step-title">
                <div class="modal-heading">
                    <div><p class="eyebrow">Step</p><h2 id="new-step-title">Add dev plan step</h2></div>
                    <button class="icon-button" type="button" aria-label="Close" @onclick="CloseStepCreator">×</button>
                </div>
                <form class="form-panel" @onsubmit="CreateStepAsync" @onsubmit:preventDefault>
                    <label>Title <input @bind="newStepTitle" placeholder="Step title" /></label>
                    <label>Description <textarea @bind="newStepDescription" placeholder="Step description"></textarea></label>
                    <label>Guidance Notes <textarea @bind="newStepGuidanceNotes" placeholder="Guidance notes for agent"></textarea></label>
                    <label><input type="checkbox" @bind="newStepAlwaysHumanReview" /> Always require Human Review</label>
                    <div class="modal-actions">
                        <button class="button-quiet" type="button" @onclick="CloseStepCreator">Cancel</button>
                        <button class="button-primary" type="submit">Create step</button>
                    </div>
                </form>
            </section>
        </div>
    }

    @if (editingStep is not null)
    {
        <div class="modal-backdrop" role="presentation">
            <section class="modal" role="dialog" aria-modal="true" aria-labelledby="edit-step-title">
                <div class="modal-heading">
                    <div><p class="eyebrow">Step details</p><h2 id="edit-step-title">Edit step</h2></div>
                    <button class="icon-button" type="button" aria-label="Close" @onclick="CloseStepEditor">×</button>
                </div>
                <form class="form-panel" @onsubmit="SaveStepAsync" @onsubmit:preventDefault>
                    <label>Title <input @bind="editStepTitle" /></label>
                    <label>Description <textarea @bind="editStepDescription"></textarea></label>
                    <label>Guidance Notes <textarea @bind="editStepGuidanceNotes"></textarea></label>
                    <label><input type="checkbox" @bind="editStepAlwaysHumanReview" /> Always require Human Review</label>
                    <div class="modal-actions">
                        <button class="button-quiet" type="button" @onclick="CloseStepEditor">Cancel</button>
                        <button class="button-primary" type="submit">Save changes</button>
                    </div>
                </form>
            </section>
        </div>
    }
}

@code {
    [Parameter] public Guid BoardId { get; set; }

    private Board? board;
    private List<Feature> features = [];
    private Dictionary<Guid, IReadOnlyList<WorkflowColumn>> featureAllowedMoves = new();
    private Dictionary<Guid, IReadOnlyList<WorkflowColumn>> stepAllowedMoves = new();

    private Dictionary<(CardType CardType, Guid CardId), int> commentCounts = new();
    private (CardType CardType, Guid CardId)? activeCommentsCard;
    private Dictionary<(CardType CardType, Guid CardId), List<Comment>> loadedComments = new();
    private string commentAuthor = "Human";
    private string commentBody = string.Empty;

    private string boardName = string.Empty;
    private string repoPath = string.Empty;
    private int concurrencyLimit;
    private bool skipFeatureHumanReview;
    private bool skipStepHumanReview;
    private int agentReviewFailThreshold;
    private int humanReviewFailThreshold;

    private bool isEditingBoard;
    private bool isCreatingFeature;
    private string newFeatureTitle = string.Empty;
    private string newFeatureRequirements = string.Empty;
    private string newFeatureAcceptanceCriteria = string.Empty;
    private string newFeatureSuggestedSolution = string.Empty;
    private bool newFeatureAlwaysHumanReview;

    private Feature? editingFeature;
    private string editFeatureTitle = string.Empty;
    private string editFeatureRequirements = string.Empty;
    private string editFeatureAcceptanceCriteria = string.Empty;
    private string editFeatureSuggestedSolution = string.Empty;
    private bool editFeatureAlwaysHumanReview;

    private bool isCreatingStep;
    private Guid stepTargetFeatureId;
    private string newStepTitle = string.Empty;
    private string newStepDescription = string.Empty;
    private string newStepGuidanceNotes = string.Empty;
    private bool newStepAlwaysHumanReview;

    private Step? editingStep;
    private string editStepTitle = string.Empty;
    private string editStepDescription = string.Empty;
    private string editStepGuidanceNotes = string.Empty;
    private bool editStepAlwaysHumanReview;

    private string? message;
    private int messageVersion;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        board = await BoardService.GetByIdAsync(BoardId);
        if (board is null)
        {
            Navigation.NavigateTo("/boards");
            return;
        }

        boardName = board.Name;
        repoPath = board.RepoPath;
        concurrencyLimit = board.ConcurrencyLimit;
        skipFeatureHumanReview = board.SkipFeatureHumanReview;
        skipStepHumanReview = board.SkipStepHumanReview;
        agentReviewFailThreshold = board.AgentReviewFailThreshold;
        humanReviewFailThreshold = board.HumanReviewFailThreshold;

        features = await FeatureService.GetForBoardAsync(BoardId);
        featureAllowedMoves.Clear();
        stepAllowedMoves.Clear();

        foreach (var f in features)
        {
            var fullFeature = await FeatureService.GetByIdAsync(f.Id);
            if (fullFeature is not null)
            {
                f.Steps = fullFeature.Steps;
            }

            try
            {
                featureAllowedMoves[f.Id] = await FeatureOrchestrator.GetAllowedMovesAsync(f.Id);
            }
            catch
            {
                featureAllowedMoves[f.Id] = [];
            }

            foreach (var step in f.Steps)
            {
                try
                {
                    stepAllowedMoves[step.Id] = await StepOrchestrator.GetAllowedMovesAsync(step.Id);
                }
                catch
                {
                    stepAllowedMoves[step.Id] = [];
                }
            }
        }

        commentCounts = await CommentService.GetCommentCountsForBoardAsync(BoardId);

        if (activeCommentsCard is not null)
        {
            var comments = await CommentService.GetCommentsAsync(activeCommentsCard.Value.CardType, activeCommentsCard.Value.CardId);
            loadedComments[activeCommentsCard.Value] = comments.ToList();
        }
    }

    private int GetCommentCount(CardType cardType, Guid cardId) =>
        commentCounts.GetValueOrDefault((cardType, cardId), 0);

    private async Task ToggleCommentsAsync(CardType cardType, Guid cardId)
    {
        var key = (cardType, cardId);
        if (activeCommentsCard == key)
        {
            activeCommentsCard = null;
            return;
        }

        activeCommentsCard = key;
        commentBody = string.Empty;
        var comments = await CommentService.GetCommentsAsync(cardType, cardId);
        loadedComments[key] = comments.ToList();
    }

    private void CloseComments() => activeCommentsCard = null;

    private async Task AddCommentAsync(CardType cardType, Guid cardId)
    {
        if (string.IsNullOrWhiteSpace(commentBody))
        {
            ShowMessage("Comment text cannot be empty.");
            return;
        }

        var author = string.IsNullOrWhiteSpace(commentAuthor) ? "Human" : commentAuthor.Trim();

        try
        {
            await CommentService.AddCommentAsync(cardType, cardId, author, commentBody);
            commentBody = string.Empty;
            var key = (cardType, cardId);
            var comments = await CommentService.GetCommentsAsync(cardType, cardId);
            loadedComments[key] = comments.ToList();
            commentCounts[key] = comments.Count;
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message);
        }
    }

    private void OpenBoardEditor() => isEditingBoard = true;
    private void CloseBoardEditor() => isEditingBoard = false;

    private async Task SaveBoardAsync()
    {
        try
        {
            await BoardService.UpdateAsync(BoardId, boardName, repoPath, concurrencyLimit, skipFeatureHumanReview, skipStepHumanReview, agentReviewFailThreshold, humanReviewFailThreshold);
            CloseBoardEditor();
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private void OpenFeatureCreator() => isCreatingFeature = true;
    private void CloseFeatureCreator() => isCreatingFeature = false;

    private async Task CreateFeatureAsync()
    {
        try
        {
            await FeatureService.CreateAsync(BoardId, newFeatureTitle, newFeatureRequirements, newFeatureAcceptanceCriteria, newFeatureSuggestedSolution, newFeatureAlwaysHumanReview);
            newFeatureTitle = newFeatureRequirements = newFeatureAcceptanceCriteria = newFeatureSuggestedSolution = string.Empty;
            newFeatureAlwaysHumanReview = false;
            CloseFeatureCreator();
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private void StartEditingFeature(Feature feature)
    {
        editingFeature = feature;
        editFeatureTitle = feature.Title;
        editFeatureRequirements = feature.Requirements;
        editFeatureAcceptanceCriteria = feature.AcceptanceCriteria;
        editFeatureSuggestedSolution = feature.SuggestedSolution;
        editFeatureAlwaysHumanReview = feature.AlwaysRequireHumanReview;
    }

    private void CloseFeatureEditor() => editingFeature = null;

    private async Task SaveFeatureAsync()
    {
        if (editingFeature is null) return;
        try
        {
            await FeatureService.UpdateAsync(editingFeature.Id, editFeatureTitle, editFeatureRequirements, editFeatureAcceptanceCriteria, editFeatureSuggestedSolution, editFeatureAlwaysHumanReview);
            CloseFeatureEditor();
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private async Task DeleteFeatureAsync(Guid featureId)
    {
        try
        {
            await FeatureService.DeleteAsync(featureId);
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private async Task MoveFeatureAsync(Guid featureId, WorkflowColumn target)
    {
        try
        {
            await FeatureOrchestrator.MoveAsync(featureId, target);
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private void OpenStepCreator(Guid featureId)
    {
        stepTargetFeatureId = featureId;
        newStepTitle = string.Empty;
        newStepDescription = string.Empty;
        newStepGuidanceNotes = string.Empty;
        newStepAlwaysHumanReview = false;
        isCreatingStep = true;
    }

    private void CloseStepCreator() => isCreatingStep = false;

    private async Task CreateStepAsync()
    {
        try
        {
            await StepService.CreateAsync(stepTargetFeatureId, newStepTitle, newStepDescription, newStepGuidanceNotes, newStepAlwaysHumanReview);
            newStepTitle = newStepDescription = newStepGuidanceNotes = string.Empty;
            newStepAlwaysHumanReview = false;
            CloseStepCreator();
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private void StartEditingStep(Step step)
    {
        editingStep = step;
        editStepTitle = step.Title;
        editStepDescription = step.Description;
        editStepGuidanceNotes = step.GuidanceNotes;
        editStepAlwaysHumanReview = step.AlwaysRequireHumanReview;
    }

    private void CloseStepEditor() => editingStep = null;

    private async Task SaveStepAsync()
    {
        if (editingStep is null) return;
        try
        {
            await StepService.UpdateAsync(editingStep.Id, editStepTitle, editStepDescription, editStepGuidanceNotes, editStepAlwaysHumanReview);
            CloseStepEditor();
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private async Task DeleteStepAsync(Guid stepId)
    {
        try
        {
            await StepService.DeleteAsync(stepId);
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private async Task MoveStepAsync(Guid stepId, WorkflowColumn target)
    {
        try
        {
            await StepOrchestrator.MoveAsync(stepId, target);
            await LoadAsync();
        }
        catch (Exception exception) { ShowMessage(exception.Message); }
    }

    private void ShowMessage(string text)
    {
        message = text;
        messageVersion++;
    }

    private void DismissMessage() => message = null;
}
