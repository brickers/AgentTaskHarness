@page "/boards/{BoardId:guid}"
@using AgentTaskHarness.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using BoardEntity = AgentTaskHarness.Domain.Entities.Board
@using AgentTaskHarness.Domain.Entities
@using AgentTaskHarness.Domain.Enums

@inject BoardService BoardService
@inject FeatureService FeatureService
@inject StepService StepService
@inject FeatureTransitionOrchestrator FeatureOrchestrator
@inject StepTransitionOrchestrator StepOrchestrator
@inject IAgentScheduler AgentScheduler
@inject ReviewOutcomeService ReviewOutcomeService
@inject UsageTrackingService UsageService
@inject AppDbContext DbContext
@inject NavigationManager Navigation

<PageTitle>@(_board?.Name ?? "Board") - AgentTaskHarness</PageTitle>

@if (_board is null)
{
    <div class="p-4">Loading board...</div>
}
else
{
    <PageTemplate Title="Board" Eyebrow="@_board.Name"
                  Description="Manage features and development steps across the workflow.">
        <Actions>
            <button class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                    @onclick="OpenFeatureCreator">New feature
            </button>
        </Actions>
        <ChildContent>
            <div class="flex max-w-full flex-col gap-6 font-sans">
                @if (!string.IsNullOrWhiteSpace(_notificationMessage))
                {
                    <div class="rounded-md border-[3px] p-3 text-sm @(_isNotificationError ? "border-red-200 bg-red-50 text-red-700" : "border-blue-200 bg-blue-50 text-blue-700")" role="alert">
                        <span>@_notificationMessage</span>
                        <button type="button" class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" aria-label="Dismiss"
                                @onclick="() => _notificationMessage = null"></button>
                    </div>
                }

                <!-- Row 1: Features Kanban Grid -->
                <section class="flex flex-col gap-2.5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <h2 class="m-0 text-lg font-bold text-slate-800">Features</h2>
                            <span class="text-sm text-slate-500">(@_features.Count total)</span>
                        </div>
                        <div class="flex gap-2">
                            <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="OpenFeatureCreator">+ Add Feature
                            </button>
                        </div>
                    </div>

                    <div class="flex items-stretch gap-6 overflow-x-auto pb-2">
                        @foreach (var column in _columns)
                        {
                            var columnFeatures = _features.Where(f => f.WorkflowColumn == column).ToList();
                            var isValidTarget = _draggedCardType == CardType.Feature && _currentAllowedDropColumns.Contains(column);
                            var isInvalidTarget = _draggedCardType == CardType.Feature && !_currentAllowedDropColumns.Contains(column);
                            var isOver = _draggedOverColumn == column && _draggedCardType == CardType.Feature;

                            <div
                                 class="flex min-h-60 min-w-0 max-h-[520px] flex-[0_0_190px] flex-col rounded-lg border-[3px] border-slate-400 bg-slate-50 transition-all"
                                @ondragover:preventDefault="true"
                                @ondragenter="() => HandleDragEnter(column, CardType.Feature)"
                                @ondragleave="() => HandleDragLeave(column)"
                                @ondrop="() => HandleFeatureDrop(column)">

                                 <div class="flex items-center justify-between rounded-none border-0 bg-slate-400 px-3.5 py-2.5">
                                    <div><h3>@column</h3></div>
                                    <span class="rounded-full bg-slate-200 px-1.5 py-0.5 text-xs font-bold text-slate-600">@columnFeatures.Count</span>
                                </div>

                                 <div class="flex flex-1 flex-col overflow-y-auto p-2.5">
                                    @foreach (var feature in columnFeatures)
                                    {
                                        var run = _featureRuns.GetValueOrDefault(feature.Id);
                                        var stepStatuses = _featureStepStatuses.GetValueOrDefault(feature.Id, []);
                                        var isSelected = _selectedFeatureId == feature.Id;

                                        <FeatureCard Feature="@feature"
                                                     Board="@_board"
                                                     CurrentRun="@run"
                                                     ChildStepStatuses="@stepStatuses"
                                                     IsSelected="@isSelected"
                                                     OnSelect="HandleFeatureSelected"
                                                     OnOpenDetails="OpenFeaturePopup"
                                                     OnDragStart="HandleFeatureDragStart"
                                                     OnDragEnd="HandleDragEnd"/>
                                    }
                                 </div>
                             </div>

                             @if (column is WorkflowColumn.Ready or WorkflowColumn.AgentReview)
                             {
                                 <div class="flex shrink-0 self-stretch border-l-[3px] border-dashed border-slate-400" aria-hidden="true"></div>
                             }
                         }
                    </div>
                </section>

                <!-- Row 2: Steps Kanban Grid (Filtered by Selected Feature or Showing All Steps) -->
                <section class="flex flex-col gap-2.5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <h2 class="m-0 text-lg font-bold text-slate-800">
                                @if (_selectedFeature != null)
                                {
                                    <span>Steps for: <strong>@_selectedFeature.Title</strong></span>
                                }
                                else
                                {
                                    <span>Steps (All Features)</span>
                                }
                            </h2>
                            <span class="text-sm text-slate-500">(@_selectedFeatureSteps.Count dev plan steps)</span>
                            @if (_selectedFeature != null)
                            {
                                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="ClearFeatureFilter"
                                        title="Unselect feature and show all steps">
                                    ✕ Clear Filter
                                </button>
                            }
                        </div>
                        <div class="flex gap-2">
                            <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="OpenStepCreator">+ Add Step
                            </button>
                        </div>
                    </div>

                    <div class="flex items-stretch gap-6 overflow-x-auto pb-2">
                        @foreach (var column in _columns)
                        {
                            var columnSteps = _selectedFeatureSteps.Where(s => s.WorkflowColumn == column).ToList();
                            var isValidTarget = _draggedCardType == CardType.Step && _currentAllowedDropColumns.Contains(column);
                            var isInvalidTarget = _draggedCardType == CardType.Step && !_currentAllowedDropColumns.Contains(column);
                            var isOver = _draggedOverColumn == column && _draggedCardType == CardType.Step;

                            <div
                                 class="flex min-h-60 min-w-0 max-h-[520px] flex-[0_0_190px] flex-col rounded-lg border-[3px] border-slate-400 bg-slate-50 transition-all"
                                @ondragover:preventDefault="true"
                                @ondragenter="() => HandleDragEnter(column, CardType.Step)"
                                @ondragleave="() => HandleDragLeave(column)"
                                @ondrop="() => HandleStepDrop(column)">

                                <div class="flex items-center justify-between rounded-none border-0 bg-slate-400 px-3.5 py-2.5">
                                    <div><h3>@column</h3></div>
                                    <span class="rounded-full bg-slate-200 px-1.5 py-0.5 text-xs font-bold text-slate-600">@columnSteps.Count</span>
                                </div>

                                 <div class="flex flex-1 flex-col overflow-y-auto p-2.5">
                                    @foreach (var step in columnSteps)
                                    {
                                        var run = _stepRuns.GetValueOrDefault(step.Id);

                                        <StepCard Step="@step"
                                                  Board="@_board"
                                                  CurrentRun="@run"
                                                  OnOpenDetails="OpenStepPopup"
                                                  OnDragStart="HandleStepDragStart"
                                                  OnDragEnd="HandleDragEnd"/>
                                    }
                                 </div>
                             </div>

                             @if (column is WorkflowColumn.Ready or WorkflowColumn.AgentReview)
                             {
                                 <div class="flex shrink-0 self-stretch border-l-[3px] border-dashed border-slate-400" aria-hidden="true"></div>
                             }
                         }
                    </div>
                </section>

                <!-- Card Details & Actions Popup Modal -->
                @if (_popupFeature != null || _popupStep != null)
                {
                    <CardPopup Feature="@_popupFeature"
                               Step="@_popupStep"
                               Board="@_board"
                               CurrentRun="@(_popupFeature != null ? _featureRuns.GetValueOrDefault(_popupFeature.Id) : _stepRuns.GetValueOrDefault(_popupStep!.Id))"
                               OnClose="CloseCardPopup"
                               OnChanged="HandleCardChanged"/>
                }

                <!-- New Feature Modal -->
                @if (_isCreatingFeature)
                {
                    <div
                        class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm"
                        @onclick="CloseFeatureCreator">
                        <div class="w-full max-w-xl rounded-xl bg-white p-6 shadow-2xl" @onclick:stopPropagation="true">
                            <div class="mb-4 flex items-center justify-between">
                                <h2>Create Feature</h2>
                                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" @onclick="CloseFeatureCreator"></button>
                            </div>
                            <form @onsubmit="CreateFeatureAsync" @onsubmit:preventDefault>
                                <div class="mb-3.5">
                                    <label>Title</label>
                                    <input class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" @bind="_newFeatureTitle" placeholder="Feature title"
                                           required/>
                                </div>
                                <div class="mb-3.5">
                                    <label>Requirements</label>
                                    <textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="3" @bind="_newFeatureRequirements"
                                              placeholder="Requirements"></textarea>
                                </div>
                                <div class="mb-3.5">
                                    <label>Acceptance Criteria</label>
                                    <textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="3" @bind="_newFeatureAcceptanceCriteria"
                                              placeholder="Acceptance criteria"></textarea>
                                </div>
                                <div class="mb-3.5">
                                    <label>Suggested Solution</label>
                                    <textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="2" @bind="_newFeatureSuggestedSolution"
                                              placeholder="Suggested solution notes"></textarea>
                                </div>
                                <div class="mb-3 flex items-center gap-2">
                                    <input type="checkbox" class="h-4 w-4 shrink-0 cursor-pointer" id="featAlwaysReview"
                                           @bind="_newFeatureAlwaysHumanReview"/>
                                    <label class="cursor-pointer text-sm font-medium text-slate-700" for="featAlwaysReview">Always require Human
                                        Review</label>
                                </div>
                                <div class="mt-5 flex justify-end gap-2.5">
                                    <button type="button" class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="CloseFeatureCreator">
                                        Cancel
                                    </button>
                                    <button type="submit" class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">Create Feature</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                <!-- New Step Modal -->
                @if (_isCreatingStep)
                {
                    <div
                        class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm"
                        @onclick="CloseStepCreator">
                        <div class="w-full max-w-xl rounded-xl bg-white p-6 shadow-2xl" @onclick:stopPropagation="true">
                            <div class="mb-4 flex items-center justify-between">
                                <h2>Add Step</h2>
                                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" @onclick="CloseStepCreator"></button>
                            </div>
                            <form @onsubmit="CreateStepAsync" @onsubmit:preventDefault>
                                <div class="mb-3.5">
                                    <label>Feature</label>
                                    <select class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" @bind="_newStepFeatureId" required>
                                        @foreach (var feat in _features)
                                        {
                                            <option value="@feat.Id">@feat.Title</option>
                                        }
                                    </select>
                                </div>
                                <div class="mb-3.5">
                                    <label>Title</label>
                                    <input class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" @bind="_newStepTitle" placeholder="Step title"
                                           required/>
                                </div>
                                <div class="mb-3.5">
                                    <label>Description</label>
                                    <textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="3" @bind="_newStepDescription"
                                              placeholder="Step description"></textarea>
                                </div>
                                <div class="mb-3.5">
                                    <label>Guidance Notes for Agent</label>
                                    <textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="2" @bind="_newStepGuidanceNotes"
                                              placeholder="Guidance notes"></textarea>
                                </div>
                                <div class="mb-3 flex items-center gap-2">
                                    <input type="checkbox" class="h-4 w-4 shrink-0 cursor-pointer" id="stepAlwaysReview"
                                           @bind="_newStepAlwaysHumanReview"/>
                                    <label class="cursor-pointer text-sm font-medium text-slate-700" for="stepAlwaysReview">Always require Human
                                        Review</label>
                                </div>
                                <div class="mt-5 flex justify-end gap-2.5">
                                    <button type="button" class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="CloseStepCreator">Cancel
                                    </button>
                                    <button type="submit" class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">Create Step</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </ChildContent>
    </PageTemplate>
}

@code {
    [Parameter] public Guid BoardId { get; set; }

    private readonly WorkflowColumn[] _columns =
    [
        WorkflowColumn.Backlog,
        WorkflowColumn.Ready,
        WorkflowColumn.Build,
        WorkflowColumn.AgentReview,
        WorkflowColumn.HumanReview,
        WorkflowColumn.Done
    ];

    private BoardEntity? _board;
    private List<Feature> _features = [];
    private Guid? _selectedFeatureId;
    private Feature? _selectedFeature;
    private List<Step> _selectedFeatureSteps = [];

    private Dictionary<Guid, AgentRun> _featureRuns = [];
    private Dictionary<Guid, AgentRun> _stepRuns = [];
    private Dictionary<Guid, List<AgentRunStatus?>> _featureStepStatuses = [];

    // Popup state
    private Feature? _popupFeature;
    private Step? _popupStep;

    // Drag & Drop state
    private CardType? _draggedCardType;
    private Feature? _draggedFeature;
    private Step? _draggedStep;
    private List<WorkflowColumn> _currentAllowedDropColumns = [];
    private WorkflowColumn? _draggedOverColumn;

    // Feature creation state
    private bool _isCreatingFeature;
    private string _newFeatureTitle = "";
    private string _newFeatureRequirements = "";
    private string _newFeatureAcceptanceCriteria = "";
    private string _newFeatureSuggestedSolution = "";
    private bool _newFeatureAlwaysHumanReview;

    // Step creation state
    private bool _isCreatingStep;
    private Guid? _newStepFeatureId;
    private string _newStepTitle = "";
    private string _newStepDescription = "";
    private string _newStepGuidanceNotes = "";
    private bool _newStepAlwaysHumanReview;

    // Notifications
    private string? _notificationMessage;
    private bool _isNotificationError;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadBoardDataAsync();
    }

    private async Task LoadBoardDataAsync()
    {
        _board = await BoardService.GetByIdAsync(BoardId);
        if (_board == null)
        {
            Navigation.NavigateTo("/boards");
            return;
        }

        _features = await FeatureService.GetForBoardAsync(BoardId);

        // Load steps for each feature and assign back-reference
        var allStepIds = new List<Guid>();
        var fStepStatuses = new Dictionary<Guid, List<AgentRunStatus?>>();

        foreach (var f in _features)
        {
            var full = await FeatureService.GetByIdAsync(f.Id);

            if (full == null) continue;

            f.Steps = full.Steps;
            foreach (var s in f.Steps)
            {
                s.Feature = f;
            }

            allStepIds.AddRange(f.Steps.Select(s => s.Id));
        }

        // Load agent runs
        var featureIds = _features.Select(f => f.Id).ToList();
        var runs = await DbContext.AgentRuns
            .AsNoTracking()
            .Where(r => (r.CardType == CardType.Feature && featureIds.Contains(r.CardId)) ||
                        (r.CardType == CardType.Step && allStepIds.Contains(r.CardId)))
            .ToListAsync();

        _featureRuns = runs
            .Where(r => r.CardType == CardType.Feature)
            .GroupBy(r => r.CardId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.StartedAt).First());

        _stepRuns = runs
            .Where(r => r.CardType == CardType.Step)
            .GroupBy(r => r.CardId)
            .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.StartedAt).First());

        foreach (var f in _features)
        {
            fStepStatuses[f.Id] = f.Steps.Select(s => _stepRuns.GetValueOrDefault(s.Id)?.Status).ToList();
        }

        _featureStepStatuses = fStepStatuses;

        // Maintain selected feature if one was selected
        if (_selectedFeatureId.HasValue)
        {
            _selectedFeature = _features.FirstOrDefault(f => f.Id == _selectedFeatureId.Value);
            if (_selectedFeature == null)
            {
                _selectedFeatureId = null;
            }
        }
        else
        {
            _selectedFeature = null;
        }

        if (_selectedFeature != null)
        {
            _selectedFeatureSteps = _selectedFeature.Steps.OrderBy(s => s.CreatedAt).ToList();
        }
        else
        {
            _selectedFeatureSteps = _features.SelectMany(f => f.Steps).OrderBy(s => s.CreatedAt).ToList();
        }
    }

    private void HandleFeatureSelected(Feature feature)
    {
        if (_selectedFeatureId == feature.Id)
        {
            ClearFeatureFilter();
        }
        else
        {
            _selectedFeatureId = feature.Id;
            _selectedFeature = feature;
            _selectedFeatureSteps = feature.Steps.OrderBy(s => s.CreatedAt).ToList();
        }
    }

    private void ClearFeatureFilter()
    {
        _selectedFeatureId = null;
        _selectedFeature = null;
        _selectedFeatureSteps = _features.SelectMany(f => f.Steps).OrderBy(s => s.CreatedAt).ToList();
    }

    private void OpenFeaturePopup(Feature feature)
    {
        _popupFeature = feature;
        _popupStep = null;
    }

    private void OpenStepPopup(Step step)
    {
        _popupStep = step;
        _popupFeature = null;
    }

    private void CloseCardPopup()
    {
        _popupFeature = null;
        _popupStep = null;
    }

    private async Task HandleCardChanged()
    {
        await LoadBoardDataAsync();
        if (_popupFeature != null)
        {
            _popupFeature = _features.FirstOrDefault(f => f.Id == _popupFeature.Id);
        }

        if (_popupStep != null)
        {
            _popupStep = _selectedFeatureSteps.FirstOrDefault(s => s.Id == _popupStep.Id);
        }
    }

    // Drag & Drop
    private async Task HandleFeatureDragStart(Feature feature)
    {
        if (await AgentScheduler.IsAgentRunningAsync(CardType.Feature, feature.Id))
        {
            return; // Hard blocked
        }

        _draggedCardType = CardType.Feature;
        _draggedFeature = feature;
        _draggedStep = null;

        var allowed = await FeatureOrchestrator.GetAllowedMovesAsync(feature.Id);
        _currentAllowedDropColumns = allowed.ToList();
    }

    private async Task HandleStepDragStart(Step step)
    {
        if (await AgentScheduler.IsAgentRunningAsync(CardType.Step, step.Id))
        {
            return; // Hard blocked
        }

        _draggedCardType = CardType.Step;
        _draggedStep = step;
        _draggedFeature = null;

        var allowed = await StepOrchestrator.GetAllowedMovesAsync(step.Id);
        _currentAllowedDropColumns = allowed.ToList();
    }

    private void HandleDragEnter(WorkflowColumn column, CardType cardType)
    {
        if (_draggedCardType == cardType)
        {
            _draggedOverColumn = column;
        }
    }

    private void HandleDragLeave(WorkflowColumn column)
    {
        if (_draggedOverColumn == column)
        {
            _draggedOverColumn = null;
        }
    }

    private void HandleDragEnd()
    {
        _draggedCardType = null;
        _draggedFeature = null;
        _draggedStep = null;
        _currentAllowedDropColumns.Clear();
        _draggedOverColumn = null;
    }

    private async Task HandleFeatureDrop(WorkflowColumn targetColumn)
    {
        if (_draggedFeature == null || !_currentAllowedDropColumns.Contains(targetColumn))
        {
            HandleDragEnd();
            return;
        }

        try
        {
            await FeatureOrchestrator.MoveAsync(_draggedFeature.Id, targetColumn);
            Notify($"Moved feature to {targetColumn}.", false);
            await LoadBoardDataAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, true);
        }
        finally
        {
            HandleDragEnd();
        }
    }

    private async Task HandleStepDrop(WorkflowColumn targetColumn)
    {
        if (_draggedStep == null || !_currentAllowedDropColumns.Contains(targetColumn))
        {
            HandleDragEnd();
            return;
        }

        try
        {
            await StepOrchestrator.MoveAsync(_draggedStep.Id, targetColumn);
            Notify($"Moved step to {targetColumn}.", false);
            await LoadBoardDataAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, true);
        }
        finally
        {
            HandleDragEnd();
        }
    }

    // Feature Creator
    private void OpenFeatureCreator()
    {
        _isCreatingFeature = true;
    }

    private void CloseFeatureCreator()
    {
        _isCreatingFeature = false;
    }

    private async Task CreateFeatureAsync()
    {
        try
        {
            var feat = await FeatureService.CreateAsync(BoardId, _newFeatureTitle, _newFeatureRequirements, _newFeatureAcceptanceCriteria, _newFeatureSuggestedSolution, _newFeatureAlwaysHumanReview);
            _newFeatureTitle = _newFeatureRequirements = _newFeatureAcceptanceCriteria = _newFeatureSuggestedSolution = "";
            _newFeatureAlwaysHumanReview = false;
            CloseFeatureCreator();
            _selectedFeatureId = feat.Id;
            Notify("Feature created.", false);
            await LoadBoardDataAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, true);
        }
    }

    // Step Creator
    private void OpenStepCreator()
    {
        if (_features.Count == 0)
        {
            Notify("Please create a feature before adding steps.", true);
            return;
        }

        _newStepFeatureId = _selectedFeatureId ?? _features[0].Id;
        _isCreatingStep = true;
    }

    private void CloseStepCreator()
    {
        _isCreatingStep = false;
    }

    private async Task CreateStepAsync()
    {
        if (!_newStepFeatureId.HasValue) return;
        try
        {
            await StepService.CreateAsync(_newStepFeatureId.Value, _newStepTitle, _newStepDescription, _newStepGuidanceNotes, _newStepAlwaysHumanReview);
            _newStepTitle = _newStepDescription = _newStepGuidanceNotes = "";
            _newStepAlwaysHumanReview = false;
            CloseStepCreator();
            Notify("Step created.", false);
            await LoadBoardDataAsync();
        }
        catch (Exception ex)
        {
            Notify(ex.Message, true);
        }
    }

    private void Notify(string text, bool isError)
    {
        _notificationMessage = text;
        _isNotificationError = isError;
    }

}
