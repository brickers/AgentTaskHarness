@page "/boards/{BoardId:guid}/columns"
@inject BoardService BoardService
@inject ColumnService ColumnService
@inject AgentDefinitionService AgentDefinitionService
@inject NavigationManager Navigation

<PageTitle>Column configuration</PageTitle>

<p><a href="@($"/boards/{BoardId}")">Back to board</a></p>
<h1>Column configuration</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="message" role="alert">@message</p>
}

<section class="form-panel">
    <h2>New column</h2>
    <label>Name <input @bind="newColumnName" /></label>
    <button @onclick="CreateAsync">Add column</button>
</section>

@foreach (var column in columns)
{
    <section class="column-config">
        <h2>@column.Name</h2>
        <label>Name <input @bind="column.Name" /></label>
        <label>Order <input type="number" min="0" @bind="column.Order" /></label>
        <label><input type="checkbox" @bind="column.IsBacklog" disabled /> Backlog</label>
        <label><input type="checkbox" @bind="column.IsTerminal" disabled /> Terminal</label>
        @if (!column.IsBacklog && !column.IsTerminal)
        {
            <label>Agent definition
                <select @bind="column.AgentDefinitionId">
                    <option value="">No agent</option>
                    @foreach (var definition in agentDefinitions)
                    {
                        <option value="@definition.Id">@definition.Name</option>
                    }
                </select>
            </label>
        }
        <div>
            <button @onclick="() => SaveAsync(column)">Save</button>
            <button @onclick="() => MoveAsync(column.Id, -1)" disabled="@(column.Order == 0)">Earlier</button>
            <button @onclick="() => MoveAsync(column.Id, 1)" disabled="@(column.Order == columns.Count - 1)">Later</button>
            @if (!column.IsBacklog && !column.IsTerminal)
            {
                <button @onclick="() => DeleteAsync(column.Id)">Delete</button>
            }
        </div>
        <h3>Allowed destinations</h3>
        @foreach (var target in columns.Where(target => target.Id != column.Id))
        {
            var targetId = target.Id;
            <label><input type="checkbox" checked="@IsAllowed(column.Id, targetId)" @onchange="args => SetAllowedAsync(column.Id, targetId, (bool)args.Value!)" /> @target.Name</label>
        }
    </section>
}

@code {
    [Parameter] public Guid BoardId { get; set; }

    private List<Column> columns = [];
    private List<AgentDefinition> agentDefinitions = [];
    private readonly HashSet<(Guid From, Guid To)> allowedTransitions = [];
    private string newColumnName = string.Empty;
    private string? message;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (await BoardService.GetByIdAsync(BoardId) is null)
        {
            Navigation.NavigateTo("/boards");
            return;
        }
        columns = await ColumnService.GetForBoardAsync(BoardId);
        agentDefinitions = await AgentDefinitionService.GetForBoardAsync(BoardId);
        allowedTransitions.Clear();
        foreach (var column in columns)
        {
            foreach (var target in await ColumnService.GetAllowedTargetsAsync(column.Id))
            {
                allowedTransitions.Add((column.Id, target.Id));
            }
        }
    }

    private async Task CreateAsync()
    {
        try
        {
            await ColumnService.CreateAsync(BoardId, newColumnName, columns.Count);
            newColumnName = string.Empty;
            await LoadAsync();
        }
        catch (Exception exception) { message = exception.Message; }
    }

    private async Task SaveAsync(Column column)
    {
        try
        {
            await ColumnService.UpdateAsync(column.Id, column.Name, column.Order, column.IsBacklog, column.IsTerminal, column.AgentDefinitionId);
            await LoadAsync();
        }
        catch (Exception exception) { message = exception.Message; }
    }

    private async Task MoveAsync(Guid columnId, int direction)
    {
        var index = columns.FindIndex(column => column.Id == columnId);
        if (index < 0 || index + direction < 0 || index + direction >= columns.Count) return;
        (columns[index], columns[index + direction]) = (columns[index + direction], columns[index]);
        try
        {
            await ColumnService.ReorderAsync(BoardId, columns.Select(column => column.Id).ToList());
            await LoadAsync();
        }
        catch (Exception exception) { message = exception.Message; await LoadAsync(); }
    }

    private async Task DeleteAsync(Guid columnId)
    {
        try
        {
            await ColumnService.DeleteAsync(columnId);
            await LoadAsync();
        }
        catch (Exception exception) { message = exception.Message; }
    }

    private bool IsAllowed(Guid fromColumnId, Guid toColumnId) => allowedTransitions.Contains((fromColumnId, toColumnId));

    private async Task SetAllowedAsync(Guid fromColumnId, Guid toColumnId, bool allowed)
    {
        try
        {
            if (allowed) await ColumnService.AddAllowedTransitionAsync(fromColumnId, toColumnId);
            else await ColumnService.RemoveAllowedTransitionAsync(fromColumnId, toColumnId);
            await LoadAsync();
        }
        catch (Exception exception) { message = exception.Message; }
    }
}