@page "/"
@page "/boards"
@using BoardEntity = AgentTaskHarness.Domain.Entities.Board
@inject BoardService BoardService
@inject NavigationManager Navigation

<PageTitle>Boards</PageTitle>

<section class="page-intro">
    <div>
        <p class="eyebrow">Workspace</p>
        <h1>Boards</h1>
        <p>Set up a repository workspace, then shape the flow of work around it.</p>
    </div>
    <button class="button-primary" @onclick="OpenCreateDialog">New board</button>
</section>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="toast" role="alert" @key="_messageVersion"><span>@_message</span>
        <button class="icon-button" type="button" aria-label="Dismiss notification" @onclick="DismissMessage">×</button>
    </div>
}

@if (_isCreating)
{
    <div class="modal-backdrop" role="presentation">
        <section class="modal" role="dialog" aria-modal="true" aria-labelledby="new-board-title">
            <div class="modal-heading">
                <div>
                    <p class="eyebrow">New workspace</p>
                    <h2 id="new-board-title">Create board</h2>
                </div>
                <button class="icon-button" type="button" aria-label="Close" @onclick="CloseCreateDialog">×</button>
            </div>
            <form class="form-panel" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                <label>Name <input @bind="_newName" placeholder="Product workspace"/></label>
                <div class="field-group">
                    <label for="new-repository-path">Repository path</label>
                    <input id="new-repository-path" @bind="_newRepoPath" placeholder="/path/to/repository"/>
                    <small>Enter the server-visible path to an existing Git repository.</small>
                </div>
                <label>Agent concurrency <input type="number" min="1" @bind="_newConcurrencyLimit"/></label>
                <label class="checkbox-label"><input type="checkbox" @bind="_newSkipFeatureHumanReview"/> Skip Feature
                    Human Review</label>
                <label class="checkbox-label"><input type="checkbox" @bind="_newSkipStepHumanReview"/> Skip Step Human
                    Review</label>
                <div class="modal-actions">
                    <button class="button-quiet" type="button" @onclick="CloseCreateDialog">Cancel</button>
                    <button class="button-primary" type="submit">Create board</button>
                </div>
            </form>
        </section>
    </div>
}

@if (_boards.Count == 0)
{
    <section class="empty-state">
        <p class="eyebrow">No boards yet</p>
        <h2>Start with a repository</h2>
        <p>Create a board to begin managing work.</p>
        <button class="button-primary" @onclick="OpenCreateDialog">Create your first board</button>
    </section>
}
else
{
    <ul class="board-list">
        @foreach (var board in _boards)
        {
            <li>
                <div>
                    <a href="@($"/boards/{board.Id}")">@board.Name</a>
                    <span>@board.RepoPath</span>
                </div>
                <div class="board-list-actions">
                    <a class="button-quiet" href="@($"/boards/{board.Id}")">Board</a>
                    <a class="button-quiet" href="@($"/boards/{board.Id}/roadmap")">Roadmap</a>
                    <a class="button-quiet" href="@($"/boards/{board.Id}/agents")">Agents</a>
                    <button class="button-danger" @onclick="() => DeleteAsync(board.Id)">Delete</button>
                </div>
            </li>
        }
    </ul>
}

@code {
    private List<BoardEntity> _boards = [];
    private string _newName = string.Empty;
    private string _newRepoPath = string.Empty;
    private int _newConcurrencyLimit = 1;
    private bool _newSkipFeatureHumanReview;
    private bool _newSkipStepHumanReview;
    private bool _isCreating;
    private string? _message;
    private int _messageVersion;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private void OpenCreateDialog()
    {
        _newName = string.Empty;
        _newRepoPath = string.Empty;
        _newConcurrencyLimit = 1;
        _newSkipFeatureHumanReview = false;
        _newSkipStepHumanReview = false;
        _isCreating = true;
    }

    private void CloseCreateDialog()
    {
        _isCreating = false;
    }

    private async Task CreateAsync()
    {
        try
        {
            var board = await BoardService.CreateAsync(_newName, _newRepoPath, _newConcurrencyLimit, _newSkipFeatureHumanReview, _newSkipStepHumanReview);
            CloseCreateDialog();
            Navigation.NavigateTo($"/boards/{board.Id}");
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private async Task DeleteAsync(Guid boardId)
    {
        try
        {
            await BoardService.DeleteAsync(boardId);
            await LoadAsync();
        }
        catch (Exception exception)
        {
            ShowMessage(exception.Message);
        }
    }

    private async Task LoadAsync()
    {
        _boards = await BoardService.GetAllAsync();
    }

    private void ShowMessage(string text)
    {
        _message = text;
        _messageVersion++;
    }

    private void DismissMessage()
    {
        _message = null;
    }

}
