        font-size: 0.85rem;
        color: #475569;
        margin: 0;
        line-height: 1.4;
    }

    .dependency-block {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 10px 12px;
    }

    .dependency-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 6px;
    }

    .dependency-title {
        font-size: 0.78rem;
        font-weight: 700;
