        align-items: center;
        justify-content: space-between;
    }

    .alert-danger {
        background: #fef2f2;
        border: 1px solid #fee2e2;
        color: #991b1b;
    }

    .alert-success {
        background: #ecfdf5;
        border: 1px solid #d1fae5;
        color: #065f46;
    }

    .btn-dismiss {
        background: none;
        border: none;
        font-size: 1.1rem;
        cursor: pointer;
        color: inherit;
    }

    .graph-scroll { overflow: auto; border: 1px solid #e2e8f0; border-radius: 10px; background: #f8fafc; padding: 12px; }
    .feature-graph { min-width: 100%; min-height: 420px; }
    .graph-edge { fill: none; stroke: #64748b; stroke-width: 2; }
    .graph-node rect { fill: white; stroke: #94a3b8; stroke-width: 2; }
    .graph-node text { fill: #1e293b; font-size: 14px; font-weight: 600; }
    .graph-node .graph-status { fill: #64748b; font-size: 11px; font-weight: 400; }
    .modal-backdrop { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 20px; background: rgba(15,23,42,.6); }
    .feature-modal { width: min(620px, 100%); background: white; border-radius: 12px; padding: 22px; box-shadow: 0 20px 40px rgba(15,23,42,.2); }
    .feature-modal form { display: grid; gap: 12px; }
    .feature-modal label { display: grid; gap: 5px; font-weight: 600; color: #334155; }
    .form-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 8px; }
</style>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private Board? _board;
    private List<Feature> _features = [];
    private Dictionary<Guid, List<FeatureDependency>> _dependencyMap = [];
    private Dictionary<Guid, List<Feature>> _dependedOnByMap = [];
    private Dictionary<Guid, bool> _unmetDependencyMap = [];
    private Dictionary<Guid, AgentRun> _agentRuns = [];
    private Dictionary<Guid, AgentRun> _stepRuns = [];
    private FeatureGraphLayout _graphLayout = FeatureGraphLayout.Create([], []);
    private bool _showGraph;
    private bool _isCreatingFeature;
    private string _newFeatureTitle = "";
    private string _newFeatureRequirements = "";
    private string _newFeatureAcceptanceCriteria = "";
    private string _newFeatureSuggestedSolution = "";
    private string? _errorMessage;
    private string? _successMessage;
    private Guid? _activeAddDepFeatureId;
    private Guid _selectedDependsOnFeatureId;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoadmapAsync();
    }

    private async Task LoadRoadmapAsync()
    {
        _errorMessage = null;
        try
        {
            _board = await DbContext.Boards
                .AsNoTracking()
                .SingleOrDefaultAsync(b => b.Id == BoardId);

            if (_board == null) return;

            _features = (await DbContext.Features
                    .AsNoTracking()
                    .Include(f => f.Steps)
                    .Where(f => f.BoardId == BoardId)
                    .ToListAsync())
                .OrderBy(f => f.CreatedAt)
                .ToList();

            var featureIds = _features.Select(f => f.Id).ToList();

            var allDependencies = await DbContext.FeatureDependencies
                .AsNoTracking()
                .Include(d => d.DependsOnFeature)
                .Where(d => featureIds.Contains(d.FeatureId))
                .ToListAsync();

            _dependencyMap = allDependencies
                .GroupBy(d => d.FeatureId)
                .ToDictionary(g => g.Key, g => g.ToList());
            _graphLayout = FeatureGraphLayout.Create(_features, allDependencies);

            _dependedOnByMap = featureIds.ToDictionary(
                fId => fId,
                fId => _features.Where(f => allDependencies.Any(d => d.FeatureId == f.Id && d.DependsOnFeatureId == fId)).ToList()
            );

            _unmetDependencyMap = [];
            foreach (var f in _features)
            {
                var areMet = await FeatureDependencyService.AreDependenciesMetAsync(f.Id);
                _unmetDependencyMap[f.Id] = !areMet;
            }

            // Load runs for features and steps
            var stepIds = _features.SelectMany(f => f.Steps).Select(s => s.Id).ToList();

            var activeRuns = await DbContext.AgentRuns
                .AsNoTracking()
                .Where(r => (r.CardType == CardType.Feature && featureIds.Contains(r.CardId)) ||
                            (r.CardType == CardType.Step && stepIds.Contains(r.CardId)))
                .ToListAsync();

            _agentRuns = activeRuns
                .Where(r => r.CardType == CardType.Feature)
                .GroupBy(r => r.CardId)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.StartedAt).First());

            _stepRuns = activeRuns
                .Where(r => r.CardType == CardType.Step)
                .GroupBy(r => r.CardId)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.StartedAt).First());
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OpenFeatureCreator() => _isCreatingFeature = true;

    private void CloseFeatureCreator() => _isCreatingFeature = false;

    private void ToggleGraphView() => _showGraph = !_showGraph;

    private async Task CreateFeatureAsync()
    {
        try
        {
            await FeatureService.CreateAsync(BoardId, _newFeatureTitle, _newFeatureRequirements,
                _newFeatureAcceptanceCriteria, _newFeatureSuggestedSolution);
            _newFeatureTitle = _newFeatureRequirements = _newFeatureAcceptanceCriteria = _newFeatureSuggestedSolution = "";
            CloseFeatureCreator();
            _successMessage = "Feature created.";
            await LoadRoadmapAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void ToggleAddDependencyForm(Guid featureId)
    {
        if (_activeAddDepFeatureId == featureId)
        {
            _activeAddDepFeatureId = null;
        }
        else
        {
            _activeAddDepFeatureId = featureId;
            _selectedDependsOnFeatureId = Guid.Empty;
        }
    }

    private async Task SaveDependency(Guid featureId)
    {
        if (_selectedDependsOnFeatureId == Guid.Empty) return;

        _errorMessage = null;
        _successMessage = null;
        try
        {
            await FeatureDependencyService.AddAsync(featureId, _selectedDependsOnFeatureId);
            _successMessage = "Dependency added.";
            _activeAddDepFeatureId = null;
            await LoadRoadmapAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task RemoveDependency(Guid featureId, Guid dependsOnFeatureId)
    {
        _errorMessage = null;
        _successMessage = null;
        try
        {
            await FeatureDependencyService.RemoveAsync(featureId, dependsOnFeatureId);
            _successMessage = "Dependency removed.";
            await LoadRoadmapAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

}
