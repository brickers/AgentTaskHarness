	.btn-dismiss { background: none; border: none; font-size: 1.1rem; cursor: pointer; color: inherit; }
</style>

@code {
	[Parameter] public Guid BoardId { get; set; }

	private Board? board;
	private List<Feature> features = [];
	private Dictionary<Guid, List<FeatureDependency>> dependencyMap = [];
	private Dictionary<Guid, List<Feature>> dependedOnByMap = [];
	private Dictionary<Guid, bool> unmetDependencyMap = [];
	private Dictionary<Guid, AgentRun> agentRuns = [];
	private Dictionary<Guid, AgentRun> stepRuns = [];
	private string? errorMessage;
	private string? successMessage;
	private Guid? activeAddDepFeatureId;
	private Guid selectedDependsOnFeatureId;

	protected override async Task OnInitializedAsync()
	{
		await LoadRoadmapAsync();
	}

	private async Task LoadRoadmapAsync()
	{
		errorMessage = null;
		try
		{
			board = await DbContext.Boards
				.AsNoTracking()
				.SingleOrDefaultAsync(b => b.Id == BoardId);

			if (board == null) return;

			features = await DbContext.Features
				.Include(f => f.Steps)
				.Where(f => f.BoardId == BoardId)
				.OrderBy(f => f.CreatedAt)
				.ToListAsync();

			var featureIds = features.Select(f => f.Id).ToList();

			var allDependencies = await DbContext.FeatureDependencies
				.AsNoTracking()
				.Include(d => d.DependsOnFeature)
				.Where(d => featureIds.Contains(d.FeatureId))
				.ToListAsync();

			dependencyMap = allDependencies
				.GroupBy(d => d.FeatureId)
				.ToDictionary(g => g.Key, g => g.ToList());

			dependedOnByMap = featureIds.ToDictionary(
				fId => fId,
				fId => features.Where(f => allDependencies.Any(d => d.FeatureId == f.Id && d.DependsOnFeatureId == fId)).ToList()
			);

			unmetDependencyMap = [];
			foreach (var f in features)
			{
				var areMet = await FeatureDependencyService.AreDependenciesMetAsync(f.Id);
				unmetDependencyMap[f.Id] = !areMet;
			}

			// Load runs for features and steps
			var stepIds = features.SelectMany(f => f.Steps).Select(s => s.Id).ToList();

			var activeRuns = await DbContext.AgentRuns
				.AsNoTracking()
				.Where(r => (r.CardType == CardType.Feature && featureIds.Contains(r.CardId)) ||
							(r.CardType == CardType.Step && stepIds.Contains(r.CardId)))
				.ToListAsync();

			agentRuns = activeRuns
				.Where(r => r.CardType == CardType.Feature)
				.GroupBy(r => r.CardId)
				.ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.StartedAt).First());

			stepRuns = activeRuns
				.Where(r => r.CardType == CardType.Step)
				.GroupBy(r => r.CardId)
				.ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.StartedAt).First());
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
	}

	private void ToggleAddDependencyForm(Guid featureId)
	{
		if (activeAddDepFeatureId == featureId)
		{
			activeAddDepFeatureId = null;
		}
		else
		{
			activeAddDepFeatureId = featureId;
			selectedDependsOnFeatureId = Guid.Empty;
		}
	}

	private async Task SaveDependency(Guid featureId)
	{
		if (selectedDependsOnFeatureId == Guid.Empty) return;

		errorMessage = null;
		successMessage = null;
		try
		{
			await FeatureDependencyService.AddAsync(featureId, selectedDependsOnFeatureId);
			successMessage = "Dependency added.";
			activeAddDepFeatureId = null;
			await LoadRoadmapAsync();
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
	}

	private async Task RemoveDependency(Guid featureId, Guid dependsOnFeatureId)
	{
		errorMessage = null;
		successMessage = null;
		try
		{
			await FeatureDependencyService.RemoveAsync(featureId, dependsOnFeatureId);
			successMessage = "Dependency removed.";
			await LoadRoadmapAsync();
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
	}
}
