@page "/boards/{BoardId:guid}/roadmap"
@using AgentTaskHarness.Application.Agents
@using AgentTaskHarness.Application.Boards
@using AgentTaskHarness.Application.Features
@using AgentTaskHarness.Application.Reviews
@using AgentTaskHarness.Domain.Entities
@using AgentTaskHarness.Domain.Enums
@using AgentTaskHarness.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore

@inject AppDbContext DbContext
@inject FeatureDependencyService FeatureDependencyService
@inject ReviewOutcomeService ReviewOutcomeService
@inject IAgentScheduler AgentScheduler
@inject NavigationManager Navigation

<PageTitle>@(board?.Name ?? "Roadmap") - Roadmap</PageTitle>

<div class="roadmap-page">
	<header class="roadmap-header">
		<div class="header-left">
			<a href="@($"/boards/{BoardId}")" class="back-link">&larr; Back to Board</a>
			<h1 class="page-title">Roadmap: @(board?.Name ?? "Loading...")</h1>
			<p class="page-desc">Computed dependency tree and delivery plan for features on this board.</p>
		</div>
		<div class="header-right">
			<a href="@($"/boards/{BoardId}")" class="btn btn-primary">Kanban Board</a>
			<a href="@($"/boards/{BoardId}/agents")" class="btn btn-outline-secondary">Agents</a>
		</div>
	</header>

	@if (!string.IsNullOrEmpty(errorMessage))
	{
		<div class="alert alert-danger" role="alert">
			@errorMessage
			<button type="button" class="btn-dismiss" @onclick="() => errorMessage = null">&times;</button>
		</div>
	}

	@if (!string.IsNullOrEmpty(successMessage))
	{
		<div class="alert alert-success" role="alert">
			@successMessage
			<button type="button" class="btn-dismiss" @onclick="() => successMessage = null">&times;</button>
		</div>
	}

	@if (board == null)
	{
		<div class="loading-state">Loading board roadmap...</div>
	}
	else if (features.Count == 0)
	{
		<div class="empty-state">
			<h3>No features created yet</h3>
			<p>Create features on the <a href="@($"/boards/{BoardId}")">Board</a> to view their roadmap plan and dependencies here.</p>
		</div>
	}
	else
	{
		<div class="roadmap-grid">
			@foreach (var feature in features)
			{
				var isUnmet = unmetDependencyMap.GetValueOrDefault(feature.Id, false);
				var deps = dependencyMap.GetValueOrDefault(feature.Id, []);
				var dependedOnBy = dependedOnByMap.GetValueOrDefault(feature.Id, []);
				var run = agentRuns.GetValueOrDefault(feature.Id);
				var isRework = feature.WorkflowColumn == WorkflowColumn.Build && ReviewOutcomeService.IsRework(feature);
				var hasIssue = ReviewOutcomeService.HasIssue(feature, board);

				<div class="feature-node-card @(feature.WorkflowColumn == WorkflowColumn.Done ? "feature-done" : "")">
					<div class="feature-node-header">
						<div class="feature-title-area">
							<StatusIcon Status="@run?.Status" />
							<h3 class="feature-title">@feature.Title</h3>
						</div>
						<div class="feature-badges">
							<span class="column-pill pill-@feature.WorkflowColumn.ToString().ToLower()">@feature.WorkflowColumn</span>
							@if (isRework)
							{
								<span class="badge badge-rework">Rework</span>
							}
							@if (hasIssue)
							{
								<span class="badge badge-issue">Issue</span>
							}
						</div>
					</div>

					@if (!string.IsNullOrWhiteSpace(feature.Requirements))
					{
						<p class="feature-requirements">@feature.Requirements</p>
					}

					<!-- Dependencies Section -->
					<div class="dependency-block">
						<div class="dependency-header">
							<span class="dependency-title">Dependencies (@deps.Count)</span>
							@if (feature.WorkflowColumn == WorkflowColumn.Backlog)
							{
								<button class="btn btn-sm btn-outline-primary" @onclick="() => ToggleAddDependencyForm(feature.Id)">
									@(activeAddDepFeatureId == feature.Id ? "Cancel" : "+ Add Dependency")
								</button>
							}
						</div>

						@if (activeAddDepFeatureId == feature.Id)
						{
							<div class="add-dep-form">
								<select class="form-select form-select-sm" @bind="selectedDependsOnFeatureId">
									<option value="">Select feature this depends on...</option>
									@foreach (var candidate in features.Where(f => f.Id != feature.Id && !deps.Any(d => d.DependsOnFeatureId == f.Id)))
									{
										<option value="@candidate.Id">@candidate.Title (@candidate.WorkflowColumn)</option>
									}
								</select>
								<button class="btn btn-sm btn-success" @onclick="() => SaveDependency(feature.Id)" disabled="@(selectedDependsOnFeatureId == Guid.Empty)">
									Add
								</button>
							</div>
						}

						@if (deps.Count == 0)
						{
							<span class="text-muted small">No prerequisites (root feature)</span>
						}
						else
						{
							<div class="dep-list">
								@foreach (var d in deps)
								{
									var depFeat = features.FirstOrDefault(f => f.Id == d.DependsOnFeatureId);
									<div class="dep-item @(depFeat?.WorkflowColumn == WorkflowColumn.Done ? "dep-satisfied" : "dep-pending")">
										<span class="dep-dot"></span>
										<span class="dep-name">@(depFeat?.Title ?? "Unknown")</span>
										<span class="dep-status">(@(depFeat?.WorkflowColumn.ToString() ?? "Unknown"))</span>

										@if (feature.WorkflowColumn == WorkflowColumn.Backlog)
										{
											<button class="btn-remove-dep" title="Remove dependency" @onclick="() => RemoveDependency(feature.Id, d.DependsOnFeatureId)">&times;</button>
										}
									</div>
								}
							</div>
						}

						@if (dependedOnBy.Count > 0)
						{
							<div class="depended-by-section mt-2">
								<span class="dependency-title text-muted">Blocks:</span>
								<div class="dep-list">
									@foreach (var blocker in dependedOnBy)
									{
										<span class="dep-badge">@blocker.Title</span>
									}
								</div>
							</div>
						}
					</div>

					<!-- Dev Plan Steps Section -->
					@if (feature.Steps.Count > 0)
					{
						<div class="steps-plan-block">
							<div class="steps-header">
								<span class="steps-count">Dev Plan: @feature.Steps.Count(s => s.WorkflowColumn == WorkflowColumn.Done) / @feature.Steps.Count completed</span>
							</div>
							<div class="steps-progress-bar">
								@{
									var pct = feature.Steps.Count > 0 ? (feature.Steps.Count(s => s.WorkflowColumn == WorkflowColumn.Done) * 100) / feature.Steps.Count : 0;
								}
								<div class="progress-fill" style="width: @pct%"></div>
							</div>
							<div class="nested-steps-list">
								@foreach (var step in feature.Steps.OrderBy(s => s.CreatedAt))
								{
									var stepRun = stepRuns.GetValueOrDefault(step.Id);
									<div class="nested-step-item">
										<StatusIcon Status="@stepRun?.Status" IsMini="true" />
										<span class="nested-step-title">@step.Title</span>
										<span class="nested-step-pill">@step.WorkflowColumn</span>
									</div>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
</div>

<style>
