@page "/boards/{BoardId:guid}/roadmap"
@using AgentTaskHarness.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore

@inject AppDbContext DbContext
@inject FeatureDependencyService FeatureDependencyService
@inject FeatureService FeatureService
@inject ReviewOutcomeService ReviewOutcomeService
@inject IAgentScheduler AgentScheduler
@inject NavigationManager Navigation

<PageTitle>@(_board?.Name ?? "Roadmap") - Roadmap</PageTitle>

<PageTemplate Title="Roadmap" Eyebrow="@(_board?.Name ?? "Project")"
              Description="Computed dependency tree and delivery plan for project features.">
    <Actions>
        <button class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                @onclick="OpenFeatureCreator">New feature
        </button>
    </Actions>
    <ChildContent>
        <div class="mx-auto">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="flex items-center justify-between gap-3 border-[3px] border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert">
                    @_errorMessage
                    <button type="button" class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" @onclick="() => _errorMessage = null">&times;</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="flex items-center justify-between gap-3 border-[3px] border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-700" role="alert">
                    @_successMessage
                    <button type="button" class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" @onclick="() => _successMessage = null">&times;</button>
                </div>
            }

            @if (_board == null)
            {
                <div class="rounded-lg border-[3px] border-slate-200 bg-white p-8 text-center text-slate-500">Loading board roadmap...</div>
            }
            else if (_features.Count == 0)
            {
                <div class="rounded-lg border-[3px] border-dashed border-slate-300 bg-white p-8 text-center text-slate-600">
                    <h3>No features created yet</h3>
                    <p>Create features on the <a href="@($"/boards/{BoardId}")">Board</a> to view their roadmap plan and
                        dependencies here.</p>
                </div>
            }
            else if (_showGraph)
            {
                <div class="overflow-auto rounded-lg border-[3px] border-slate-200 bg-slate-50 p-3">
                    <svg class="min-h-[420px] min-w-full" viewBox="0 0 @_graphLayout.Width @_graphLayout.Height" role="img"
                         aria-label="Feature dependency graph">
                        <defs>
                            <marker id="dependency-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4"
                                    orient="auto">
                                <path d="M0,0 L8,4 L0,8 z" fill="#64748b"/>
                            </marker>
                        </defs>
                        @foreach (var edge in _graphLayout.Edges)
                        {
                            <path class="fill-none stroke-slate-500 [stroke-width:2]" d="@edge.Path" marker-end="url(#dependency-arrow)"/>
                        }
                        @foreach (var node in _graphLayout.Nodes)
                        {
                            <a href="@($"/boards/{BoardId}")" class="fill-white text-slate-800">
                                <rect x="@node.X" y="@node.Y" width="@FeatureGraphLayout.NodeWidth"
                                      height="@FeatureGraphLayout.NodeHeight" rx="8"/>
                                <text x="@(node.X + 12)" y="@(node.Y + 28)">@node.Feature.Title</text>
                                <text class="fill-slate-500 text-xs" x="@(node.X + 12)"
                                      y="@(node.Y + 52)">@node.Feature.WorkflowColumn</text>
                            </a>
                        }
                    </svg>
                </div>
            }
            else
            {
                <div class="grid gap-5 sm:grid-cols-2">
                    @foreach (var feature in _features)
                    {
                        var isUnmet = _unmetDependencyMap.GetValueOrDefault(feature.Id, false);
                        var deps = _dependencyMap.GetValueOrDefault(feature.Id, []);
                        var dependedOnBy = _dependedOnByMap.GetValueOrDefault(feature.Id, []);
                        var run = _agentRuns.GetValueOrDefault(feature.Id);
                        var isRework = feature.WorkflowColumn == WorkflowColumn.Build && ReviewOutcomeService.IsRework(feature);
                        var hasIssue = ReviewOutcomeService.HasIssue(feature, _board);

                        <div
                            class="flex flex-col gap-3 rounded-lg border-[3px] border-slate-200 bg-white p-4 shadow-sm @(feature.WorkflowColumn == WorkflowColumn.Done ? "border-emerald-300" : "")">
                            <div class="flex items-start justify-between gap-3">
                                <div class="flex min-w-0 flex-1 items-center gap-2">
                                    <StatusIcon Status="@run?.Status"/>
                                    <h3 class="truncate text-base font-semibold text-slate-800">@feature.Title</h3>
                                </div>
                                <div class="flex shrink-0 items-center gap-1.5">
                            <span
                                class="rounded bg-slate-200 px-2 py-0.5 text-xs font-semibold text-slate-700">@feature.WorkflowColumn</span>
                                    @if (isRework)
                                    {
                                        <span class="rounded bg-orange-100 px-1.5 py-0.5 text-xs font-bold text-orange-700">Rework</span>
                                    }
                                    @if (hasIssue)
                                    {
                                        <span class="rounded bg-red-100 px-1.5 py-0.5 text-xs font-bold text-red-700">Issue</span>
                                    }
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(feature.Requirements))
                            {
                                <p class="text-sm leading-6 text-slate-600">@feature.Requirements</p>
                            }

                            <!-- Dependencies Section -->
                            <div class="rounded-md border-[3px] border-slate-200 bg-slate-50 p-3">
                                <div class="flex items-center justify-between gap-3">
                                    <span class="text-xs font-bold uppercase tracking-wide text-slate-500">Dependencies (@deps.Count)</span>
                                    @if (feature.WorkflowColumn == WorkflowColumn.Backlog)
                                    {
                                        <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                                @onclick="() => ToggleAddDependencyForm(feature.Id)">
                                            @(_activeAddDepFeatureId == feature.Id ? "Cancel" : "+ Add Dependency")
                                        </button>
                                    }
                                </div>

                                @if (_activeAddDepFeatureId == feature.Id)
                                {
                                    <div class="mt-3 flex items-center gap-2">
                                        <select class="block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" @bind="_selectedDependsOnFeatureId">
                                            <option value="">Select feature this depends on...</option>
                                            @foreach (var candidate in _features.Where(f => f.Id != feature.Id && !deps.Any(d => d.DependsOnFeatureId == f.Id)))
                                            {
                                                <option
                                                    value="@candidate.Id">@candidate.Title (@candidate.WorkflowColumn)
                                                </option>
                                            }
                                        </select>
                                        <button class="inline-flex items-center justify-center rounded-md border-[3px] border-emerald-600 bg-emerald-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-emerald-700 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                                @onclick="() => SaveDependency(feature.Id)"
                                                disabled="@(_selectedDependsOnFeatureId == Guid.Empty)">
                                            Add
                                        </button>
                                    </div>
                                }

                                @if (deps.Count == 0)
                                {
                                    <span class="text-xs text-slate-500">No prerequisites (root feature)</span>
                                }
                                else
                                {
                                        <div class="flex flex-wrap gap-2">
                                        @foreach (var d in deps)
                                        {
                                            var depFeat = _features.FirstOrDefault(f => f.Id == d.DependsOnFeatureId);
                                            <div
                                                class="flex items-center gap-1.5 text-sm @(depFeat?.WorkflowColumn == WorkflowColumn.Done ? "text-emerald-700" : "text-amber-700")">
                                                <span class="h-1.5 w-1.5 rounded-full bg-amber-400"></span>
                                                <span class="font-medium text-slate-800">@(depFeat?.Title ?? "Unknown")</span>
                                                <span
                                                    class="text-xs text-slate-500">(@(depFeat?.WorkflowColumn.ToString() ?? "Unknown"))</span>

                                                @if (feature.WorkflowColumn == WorkflowColumn.Backlog)
                                                {
                                                    <button class="inline-flex items-center justify-center rounded-md border-[3px] border-red-600 bg-red-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-red-700 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" title="Remove dependency"
                                                            @onclick="() => RemoveDependency(feature.Id, d.DependsOnFeatureId)">
                                                        &times;
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (dependedOnBy.Count > 0)
                                {
                                    <div class="mt-2 grid gap-2">
                                        <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Blocks:</span>
                                        <div class="grid gap-2">
                                            @foreach (var blocker in dependedOnBy)
                                            {
                                                <span class="inline-block rounded bg-slate-200 px-1.5 py-0.5 text-xs text-slate-700">@blocker.Title</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Dev Plan Steps Section -->
                            @if (feature.Steps.Count > 0)
                            {
                                <div class="border-t border-slate-200 pt-3">
                                    <div class="mb-1 text-xs font-semibold text-slate-500">
                                <span
                                    class="text-xs text-slate-500">Dev Plan: @feature.Steps.Count(s => s.WorkflowColumn == WorkflowColumn.Done) / @feature.Steps.Count completed</span>
                                    </div>
                                    <div class="mb-2 h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
                                        @{
                                            var pct = feature.Steps.Count > 0 ? feature.Steps.Count(s => s.WorkflowColumn == WorkflowColumn.Done) * 100 / feature.Steps.Count : 0;
                                        }
                                        <div class="h-full rounded-full bg-emerald-500" style="width: @pct%"></div>
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        @foreach (var step in feature.Steps.OrderBy(s => s.CreatedAt))
                                        {
                                            var stepRun = _stepRuns.GetValueOrDefault(step.Id);
                                            <div class="flex items-center gap-2 text-sm text-slate-700">
                                                <StatusIcon Status="@stepRun?.Status" IsMini="true"/>
                                                <span class="min-w-0 flex-1 truncate">@step.Title</span>
                                                <span class="rounded bg-slate-100 px-1.5 py-0.5 text-xs text-slate-500">@step.WorkflowColumn</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (_isCreatingFeature)
            {
                <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm"
                     @onclick="CloseFeatureCreator">
                    <div class="w-full max-w-2xl rounded-xl bg-white p-6 shadow-2xl" @onclick:stopPropagation="true">
                        <div class="mb-4 flex items-center justify-between"><h2 class="text-xl font-semibold text-slate-900">New Feature</h2>
                            <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" @onclick="CloseFeatureCreator">&times;</button>
                        </div>
                        <form @onsubmit="CreateFeatureAsync" @onsubmit:preventDefault>
                            <label>Title<input class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" required @bind="_newFeatureTitle"/></label>
                            <label>Requirements<textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="3"
                                                         @bind="_newFeatureRequirements"></textarea></label>
                            <label>Acceptance criteria<textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="3"
                                                                @bind="_newFeatureAcceptanceCriteria"></textarea></label>
                            <label>Solution notes<textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="3"
                                                           @bind="_newFeatureSuggestedSolution"></textarea></label>
                            <div class="mt-5 flex justify-end gap-2.5">
                                <button type="button" class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="CloseFeatureCreator">Cancel
                                </button>
                                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" type="submit">Create Feature</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</PageTemplate>

@code {
    [Parameter] public Guid BoardId { get; set; }

    private Board? _board;
    private List<Feature> _features = [];
    private Dictionary<Guid, List<FeatureDependency>> _dependencyMap = [];
    private Dictionary<Guid, List<Feature>> _dependedOnByMap = [];
    private Dictionary<Guid, bool> _unmetDependencyMap = [];
    private Dictionary<Guid, AgentRun> _agentRuns = [];
    private Dictionary<Guid, AgentRun> _stepRuns = [];
    private FeatureGraphLayout _graphLayout = FeatureGraphLayout.Create([], []);
    private bool _showGraph;
    private bool _isCreatingFeature;
    private string _newFeatureTitle = "";
    private string _newFeatureRequirements = "";
    private string _newFeatureAcceptanceCriteria = "";
    private string _newFeatureSuggestedSolution = "";
    private string? _errorMessage;
    private string? _successMessage;
    private Guid? _activeAddDepFeatureId;
    private Guid _selectedDependsOnFeatureId;

    protected override async Task OnInitializedAsync()
    {
        _showGraph = Navigation.Uri.Contains("view=graph", StringComparison.OrdinalIgnoreCase);
        await LoadRoadmapAsync();
    }

    private async Task LoadRoadmapAsync()
    {
        _errorMessage = null;
        try
        {
            _board = await DbContext.Boards
                .AsNoTracking()
                .SingleOrDefaultAsync(b => b.Id == BoardId);

            if (_board == null) return;

            _features = (await DbContext.Features
                    .AsNoTracking()
                    .Include(f => f.Steps)
                    .Where(f => f.BoardId == BoardId)
                    .ToListAsync())
                .OrderBy(f => f.CreatedAt)
                .ToList();

            var featureIds = _features.Select(f => f.Id).ToList();

            var allDependencies = await DbContext.FeatureDependencies
                .AsNoTracking()
                .Include(d => d.DependsOnFeature)
                .Where(d => featureIds.Contains(d.FeatureId))
                .ToListAsync();

            _dependencyMap = allDependencies
                .GroupBy(d => d.FeatureId)
                .ToDictionary(g => g.Key, g => g.ToList());
            _graphLayout = FeatureGraphLayout.Create(_features, allDependencies);

            _dependedOnByMap = featureIds.ToDictionary(
                fId => fId,
                fId => _features.Where(f => allDependencies.Any(d => d.FeatureId == f.Id && d.DependsOnFeatureId == fId)).ToList()
            );

            _unmetDependencyMap = [];
            foreach (var f in _features)
            {
                var areMet = await FeatureDependencyService.AreDependenciesMetAsync(f.Id);
                _unmetDependencyMap[f.Id] = !areMet;
            }

            // Load runs for features and steps
            var stepIds = _features.SelectMany(f => f.Steps).Select(s => s.Id).ToList();

            var activeRuns = await DbContext.AgentRuns
                .AsNoTracking()
                .Where(r => (r.CardType == CardType.Feature && featureIds.Contains(r.CardId)) ||
                            (r.CardType == CardType.Step && stepIds.Contains(r.CardId)))
                .ToListAsync();

            _agentRuns = activeRuns
                .Where(r => r.CardType == CardType.Feature)
                .GroupBy(r => r.CardId)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.StartedAt).First());

            _stepRuns = activeRuns
                .Where(r => r.CardType == CardType.Step)
                .GroupBy(r => r.CardId)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(r => r.StartedAt).First());
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void OpenFeatureCreator() => _isCreatingFeature = true;

    private void CloseFeatureCreator() => _isCreatingFeature = false;

    private void ToggleGraphView() => _showGraph = !_showGraph;

    private async Task CreateFeatureAsync()
    {
        try
        {
            await FeatureService.CreateAsync(BoardId, _newFeatureTitle, _newFeatureRequirements,
                _newFeatureAcceptanceCriteria, _newFeatureSuggestedSolution);
            _newFeatureTitle = _newFeatureRequirements = _newFeatureAcceptanceCriteria = _newFeatureSuggestedSolution = "";
            CloseFeatureCreator();
            _successMessage = "Feature created.";
            await LoadRoadmapAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private void ToggleAddDependencyForm(Guid featureId)
    {
        if (_activeAddDepFeatureId == featureId)
        {
            _activeAddDepFeatureId = null;
        }
        else
        {
            _activeAddDepFeatureId = featureId;
            _selectedDependsOnFeatureId = Guid.Empty;
        }
    }

    private async Task SaveDependency(Guid featureId)
    {
        if (_selectedDependsOnFeatureId == Guid.Empty) return;

        _errorMessage = null;
        _successMessage = null;
        try
        {
            await FeatureDependencyService.AddAsync(featureId, _selectedDependsOnFeatureId);
            _successMessage = "Dependency added.";
            _activeAddDepFeatureId = null;
            await LoadRoadmapAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task RemoveDependency(Guid featureId, Guid dependsOnFeatureId)
    {
        _errorMessage = null;
        _successMessage = null;
        try
        {
            await FeatureDependencyService.RemoveAsync(featureId, dependsOnFeatureId);
            _successMessage = "Dependency removed.";
            await LoadRoadmapAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

}
