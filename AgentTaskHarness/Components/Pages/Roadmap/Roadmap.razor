	.pill-ready { background: #dbeafe; color: #1d4ed8; }
	.pill-build { background: #fef3c7; color: #b45309; }
	.pill-agentreview { background: #ede9fe; color: #6d28d9; }
	.pill-humanreview { background: #fae8ff; color: #86198f; }
	.pill-done { background: #dcfce7; color: #15803d; }
