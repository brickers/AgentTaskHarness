<div class="mb-2 select-none rounded-lg border-[3px] border-slate-200 bg-white p-1 shadow-sm transition hover:border-slate-300 hover:shadow-md @(IsSelected ? "border-blue-500 bg-slate-50 ring-2 ring-blue-200" : "") @(IsAgentRunning ? "cursor-default border-l-4 border-l-green-500" : "cursor-grab")"
     draggable="@(IsAgentRunning ? "false" : "true")"
     @ondragstart="HandleDragStart"
     @ondragend="HandleDragEnd"
     @onclick="HandleClick"
     title="Click to filter steps by this feature">

    <div class="flex items-center justify-between gap-1.5">
        <div class="flex min-w-0 flex-1 items-center gap-2">
            <StatusIcon Status="@CurrentRun?.Status"/>
            <span class="truncate text-sm font-semibold text-slate-800" title="@Feature.Title">@Feature.Title</span>
        </div>

        <div class="flex shrink-0 items-center gap-1.5">
            @if (ChildStepStatuses?.Count > 0)
            {
                <div class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-1.5 py-0.5" title="Step status overview (@ChildStepStatuses.Count steps)">
                    @foreach (var stepStatus in ChildStepStatuses)
                    {
                        <StatusIcon Status="@stepStatus" IsMini="true"/>
                    }
                </div>
            }
            <button class="edit-button inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 text-sm"
                    title="Edit feature details"
                    type="button"
                    @onclick="HandleEditClick"
                    @onclick:stopPropagation="true">
                edit
            </button>
        </div>
    </div>

    <div class="flex flex-wrap items-center gap-1.5">
        @if (IsRework)
        {
            <span class="rounded border-[3px] border-orange-200 bg-orange-50 px-1.5 py-0.5 text-[0.7rem] font-bold uppercase tracking-wide text-orange-700" title="Returned from review with failures">Rework</span>
        }

        @if (HasIssue)
        {
            <span class="rounded border-[3px] border-red-300 bg-red-50 px-1.5 py-0.5 text-[0.7rem] font-bold uppercase tracking-wide text-red-700" title="Failure counter reached board threshold">Issue</span>
        }

        @if (Feature.MergeConflictPending)
        {
            <span class="rounded border-[3px] border-yellow-300 bg-yellow-100 px-1.5 py-0.5 text-[0.7rem] font-bold uppercase tracking-wide text-yellow-800" title="Git merge conflict pending">Merge Conflict</span>
        }

        @if (IsAgentRunning && !string.IsNullOrWhiteSpace(CurrentRun?.SessionLink))
        {
            <a href="@CurrentRun.SessionLink"
               target="_blank"
               rel="noreferrer noopener"
               class="inline-flex items-center gap-1 rounded border-[3px] border-green-200 bg-green-100 px-1.5 py-0.5 text-[0.72rem] font-semibold text-green-700 hover:bg-green-200 hover:underline"
               @onclick:stopPropagation="true"
               title="Open the agent window">
                <span class="inline-block h-1.5 w-1.5 rounded-full bg-green-600"></span> Open Agent Window
            </a>
        }
    </div>
</div>



@code {
    [Parameter][EditorRequired] public Feature Feature { get; set; } = null!;
    [Parameter] public Board? Board { get; set; }
    [Parameter] public AgentRun? CurrentRun { get; set; }
    [Parameter] public IReadOnlyList<AgentRunStatus?>? ChildStepStatuses { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<Feature> OnSelect { get; set; }
    [Parameter] public EventCallback<Feature> OnOpenDetails { get; set; }
    [Parameter] public EventCallback<Feature> OnDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }

    [Inject] private ReviewOutcomeService ReviewOutcomeService { get; set; } = null!;

    private bool IsAgentRunning =>
        CurrentRun?.Status == AgentRunStatus.Working || CurrentRun?.Status == AgentRunStatus.WaitingForInput;

    private bool IsRework =>
        Feature.WorkflowColumn == WorkflowColumn.Build && ReviewOutcomeService.IsRework(Feature);

    private bool HasIssue =>
        Board != null && ReviewOutcomeService.HasIssue(Feature, Board);

    private async Task HandleClick()
    {
        await OnSelect.InvokeAsync(Feature);
    }

    private async Task HandleEditClick()
    {
        await OnOpenDetails.InvokeAsync(Feature);
    }

    private async Task HandleDragStart(DragEventArgs e)
    {
        if (IsAgentRunning) return;
        await OnDragStart.InvokeAsync(Feature);
    }

    private async Task HandleDragEnd(DragEventArgs e)
    {
        await OnDragEnd.InvokeAsync();
    }

}
