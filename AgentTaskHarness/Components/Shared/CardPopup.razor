@code {
	[Parameter] public Feature? Feature { get; set; }
	[Parameter] public Step? Step { get; set; }
	[Parameter] public Board? Board { get; set; }
	[Parameter] public AgentRun? CurrentRun { get; set; }
	[Parameter] public EventCallback OnClose { get; set; }
	[Parameter] public EventCallback OnChanged { get; set; }

	private string activeTab = "details";
	private bool showStatusLegend = true;
	private string? ErrorMessage;
	private string? SuccessMessage;
	private List<WorkflowColumn> allowedMoves = [];
	private List<Comment> comments = [];
	private QualitySignals? qualitySignals;
	private string newCommentAuthor = "User";
	private string newCommentBody = "";

	private bool IsFeature => Feature != null;
	private Guid CardId => IsFeature ? Feature!.Id : Step!.Id;
	private CardType CardTypeEnum => IsFeature ? CardType.Feature : CardType.Step;
	private string CardTitle => IsFeature ? Feature!.Title : Step!.Title;
	private WorkflowColumn CurrentColumn => IsFeature ? Feature!.WorkflowColumn : Step!.WorkflowColumn;
	private string? BranchName => IsFeature ? Feature!.BranchName : Step!.BranchName;
	private string? WorktreePath => IsFeature ? Feature!.WorktreePath : Step!.WorktreePath;
	private bool AlwaysRequireHumanReview => IsFeature ? Feature!.AlwaysRequireHumanReview : Step!.AlwaysRequireHumanReview;
	private int AgentReviewFailCount => IsFeature ? Feature!.AgentReviewFailCount : Step!.AgentReviewFailCount;
	private int HumanReviewFailCount => IsFeature ? Feature!.HumanReviewFailCount : Step!.HumanReviewFailCount;
	private long TokensUsed => IsFeature ? (featureSummary?.TotalTokensUsed ?? 0) : Step!.TokensUsed;
	private TimeSpan TimeSpent => IsFeature ? (featureSummary?.TotalTimeSpent ?? TimeSpan.Zero) : Step!.TimeSpent;
	private bool MergeConflictPending => IsFeature ? Feature!.MergeConflictPending : Step!.MergeConflictPending;

	private FeatureUsageSummary? featureSummary;

	private bool IsAgentRunning =>
		CurrentRun?.Status == AgentRunStatus.Working || CurrentRun?.Status == AgentRunStatus.WaitingForInput;

	private bool IsRework =>
		CurrentColumn == WorkflowColumn.Build &&
		(IsFeature ? ReviewOutcomeService.IsRework(Feature!) : ReviewOutcomeService.IsRework(Step!));

	private bool HasThresholdIssue =>
		Board != null &&
		(IsFeature ? ReviewOutcomeService.HasIssue(Feature!, Board) : ReviewOutcomeService.HasIssue(Step!, Board));

	protected override async Task OnParametersSetAsync()
	{
		await RefreshDataAsync();
	}

	private async Task RefreshDataAsync()
	{
		ErrorMessage = null;
		if (Feature == null && Step == null) return;

		try
		{
			// Load allowed moves
			if (IsFeature)
			{
				var moves = await FeatureOrchestrator.GetAllowedMovesAsync(Feature!.Id);
				allowedMoves = moves.ToList();
				featureSummary = await UsageTrackingService.GetFeatureSummaryAsync(Feature.Id);
				qualitySignals = await UsageTrackingService.GetQualitySignalsAsync(Feature.Id);
			}
			else
			{
				var moves = await StepOrchestrator.GetAllowedMovesAsync(Step!.Id);
				allowedMoves = moves.ToList();
			}

			// Load comments
			var loadedComments = await CommentService.GetCommentsAsync(CardTypeEnum, CardId);
			comments = loadedComments.ToList();

			// Load active run
			CurrentRun = await AgentScheduler.GetCurrentRunAsync(CardTypeEnum, CardId);
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
	}

	private async Task ExecuteMove(WorkflowColumn targetColumn, bool discardWorktree)
	{
		ErrorMessage = null;
		SuccessMessage = null;
		try
		{
			if (IsFeature)
			{
				await FeatureOrchestrator.MoveAsync(Feature!.Id, targetColumn, discardWorktree);
			}
			else
			{
				await StepOrchestrator.MoveAsync(Step!.Id, targetColumn, discardWorktree);
			}

			SuccessMessage = $"Moved successfully to {targetColumn}.";
			await OnChanged.InvokeAsync();
			await RefreshDataAsync();
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
	}

	private async Task HandleStopAgent()
	{
		ErrorMessage = null;
		try
		{
			await AgentScheduler.StopAgentAsync(CardTypeEnum, CardId);
			SuccessMessage = "Agent stopped.";
			await OnChanged.InvokeAsync();
			await RefreshDataAsync();
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
	}

	private async Task HandleRetryAgent()
	{
		ErrorMessage = null;
		try
		{
			if (!IsFeature)
			{
				await AgentScheduler.RetryAgentAsync(Step!.Id);
				SuccessMessage = "Agent restarted.";
				await OnChanged.InvokeAsync();
				await RefreshDataAsync();
			}
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
	}

	private async Task HandleDiscardUncommitted()
	{
		ErrorMessage = null;
		try
		{
			if (IsFeature)
			{
				await FeatureOrchestrator.DiscardUncommittedChangesAsync(Feature!.Id);
			}
			else
			{
				await StepOrchestrator.DiscardUncommittedChangesAsync(Step!.Id);
			}
			SuccessMessage = "Uncommitted changes discarded.";
			await OnChanged.InvokeAsync();
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
	}

	private async Task HandleResumeMerge()
	{
		ErrorMessage = null;
		try
		{
			if (IsFeature)
			{
				await FeatureOrchestrator.ResumeMergeAsync(Feature!.Id);
			}
			else
			{
				await StepOrchestrator.ResumeMergeAsync(Step!.Id);
			}
			SuccessMessage = "Merge resumed and finalized to Done.";
			await OnChanged.InvokeAsync();
			await RefreshDataAsync();
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
	}

	private async Task ToggleAlwaysRequireHumanReview(ChangeEventArgs e)
	{
		var value = e.Value is bool b && b;
		if (IsFeature)
		{
			Feature!.AlwaysRequireHumanReview = value;
		}
		else
		{
			Step!.AlwaysRequireHumanReview = value;
		}
		await DbContext.SaveChangesAsync();
		await OnChanged.InvokeAsync();
	}

	private async Task AddComment()
	{
		if (string.IsNullOrWhiteSpace(newCommentBody)) return;

		try
		{
			await CommentService.AddCommentAsync(CardTypeEnum, CardId, newCommentAuthor, newCommentBody);
			newCommentBody = "";
			var loadedComments = await CommentService.GetCommentsAsync(CardTypeEnum, CardId);
			comments = loadedComments.ToList();
			await OnChanged.InvokeAsync();
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
	}

	private async Task Close()
	{
		await OnClose.InvokeAsync();
	}

	private async Task HandleBackdropClick()
	{
		await Close();
	}

	private static string FormatTokens(long tokens) =>
		tokens switch
		{
			>= 1_000_000 => $"{tokens / 1_000_000.0:F1}M",
			>= 1_000 => $"{tokens / 1_000.0:F1}k",
			_ => tokens.ToString()
		};

	private static string FormatDuration(TimeSpan ts) =>
		ts.TotalHours >= 1
			? $"{(int)ts.TotalHours}h {ts.Minutes}m"
			: ts.TotalMinutes >= 1
				? $"{ts.Minutes}m {ts.Seconds}s"
				: $"{ts.Seconds}s";
}
