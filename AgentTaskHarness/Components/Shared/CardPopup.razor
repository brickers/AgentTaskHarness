@using AgentTaskHarness.Application.Agents
@using AgentTaskHarness.Application.Comments
@using AgentTaskHarness.Application.Features
@using AgentTaskHarness.Application.Reviews
@using AgentTaskHarness.Application.Steps
@using AgentTaskHarness.Application.Usage
@using AgentTaskHarness.Domain.Entities
@using AgentTaskHarness.Domain.Enums
@using AgentTaskHarness.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore

@inject AppDbContext DbContext
@inject FeatureTransitionOrchestrator FeatureOrchestrator
@inject StepTransitionOrchestrator StepOrchestrator
@inject IAgentScheduler AgentScheduler
@inject ReviewOutcomeService ReviewOutcomeService
@inject UsageTrackingService UsageTrackingService
@inject CommentService CommentService

<div class="popup-backdrop" @onclick="HandleBackdropClick">
	<div class="popup-container" @onclick:stopPropagation="true">
		@if (Feature is null && Step is null)
		{
			<div class="popup-body">
				<p>No card selected.</p>
				<button class="btn btn-secondary" @onclick="Close">Close</button>
			</div>
		}
		else
		{
			<header class="popup-header">
				<div class="header-main">
					<div class="header-meta">
						<span class="type-pill @(IsFeature ? "pill-feature" : "pill-step")">
							@(IsFeature ? "Feature" : "Step")
						</span>
						<span class="column-badge">@CurrentColumn</span>
						<StatusIcon Status="@CurrentRun?.Status" ShowText="true" />
					</div>
					<h2 class="popup-title">@CardTitle</h2>
				</div>
				<div class="header-actions">
					<button class="btn-close" @onclick="Close" aria-label="Close popup">&times;</button>
				</div>
			</header>

			@if (!string.IsNullOrEmpty(ErrorMessage))
			{
				<div class="alert alert-danger" role="alert">
					@ErrorMessage
					<button type="button" class="btn-dismiss" @onclick="() => ErrorMessage = null">&times;</button>
				</div>
			}

			@if (!string.IsNullOrEmpty(SuccessMessage))
			{
				<div class="alert alert-success" role="alert">
					@SuccessMessage
					<button type="button" class="btn-dismiss" @onclick="() => SuccessMessage = null">&times;</button>
				</div>
			}

			<!-- Rework / Issue Alerts -->
			@if (IsRework)
			{
				<div class="alert alert-warning rework-banner">
					<strong>Rework in progress:</strong> This card was returned to Build after review failures.
				</div>
			}

			@if (HasThresholdIssue)
			{
				<div class="alert alert-danger issue-banner">
					<strong>Issue threshold reached:</strong> Review failure counters reached the board limit. Agent auto-start is suspended.
				</div>
			}

			@if (MergeConflictPending)
			{
				<div class="alert alert-warning conflict-banner">
					<strong>Merge conflict pending:</strong> Worktree has git conflicts. Resolve them in the worktree and click <em>Resume Merge</em>.
				</div>
			}

			<!-- Active Agent Session Alert -->
			@if (IsAgentRunning)
			{
				<div class="agent-running-banner">
					<StatusIcon Status="@CurrentRun?.Status" ShowText="true" />
					<div class="agent-banner-info">
						<span>Agent is currently active. Card cannot be moved while agent is running.</span>
						@if (!string.IsNullOrWhiteSpace(CurrentRun?.SessionLink))
						{
							<a href="@CurrentRun.SessionLink" target="_blank" rel="noreferrer noopener" class="session-link-button">
								Open Live Copilot CLI Session &nearr;
							</a>
						}
					</div>
				</div>
			}

			<div class="popup-nav-tabs">
				<button class="nav-tab @(activeTab == "details" ? "active" : "")" @onclick='() => activeTab = "details"'>Details</button>
				<button class="nav-tab @(activeTab == "moves" ? "active" : "")" @onclick='() => activeTab = "moves"'>Available Moves</button>
				<button class="nav-tab @(activeTab == "controls" ? "active" : "")" @onclick='() => activeTab = "controls"'>Manual Controls</button>
				<button class="nav-tab @(activeTab == "usage" ? "active" : "")" @onclick='() => activeTab = "usage"'>Cost &amp; Quality</button>
				<button class="nav-tab @(activeTab == "comments" ? "active" : "")" @onclick='() => activeTab = "comments"'>Comments (@comments.Count)</button>
			</div>

			<div class="popup-content">
				@if (activeTab == "details")
				{
					<div class="tab-panel">
						<!-- Status Indicator & Explanation Section -->
						<div class="status-explanation-card">
							<div class="current-status-banner">
								<div class="status-banner-left">
									<StatusIcon Status="@CurrentRun?.Status" />
									<span class="status-banner-title">
										<strong>Status:</strong> @(CurrentRun != null ? CurrentRun.Status.ToString() : "Idle")
									</span>
								</div>
								<span class="status-banner-desc">
									@(CurrentRun != null
										? StatusIcon.GetStatusDescription(CurrentRun.Status)
										: "No active agent run. Card is currently idle.")
								</span>
							</div>

							<div class="status-legend-section">
								<div class="legend-header" @onclick="() => showStatusLegend = !showStatusLegend">
									<span class="legend-title">Status Indicator Legend</span>
									<span class="legend-toggle">@(showStatusLegend ? "Hide ▲" : "Show ▼")</span>
								</div>
								@if (showStatusLegend)
								{
									<div class="status-legend-grid">
										<div class="legend-item">
											<StatusIcon Status="@AgentRunStatus.Working" />
											<div><strong>Working:</strong> Agent is actively executing tasks and modifying code.</div>
										</div>
										<div class="legend-item">
											<StatusIcon Status="@AgentRunStatus.WaitingForInput" />
											<div><strong>Waiting for input:</strong> Agent is paused waiting for user response.</div>
										</div>
										<div class="legend-item">
											<StatusIcon Status="@AgentRunStatus.Queued" />
											<div><strong>Queued:</strong> Scheduled and awaiting an available worker slot.</div>
										</div>
										<div class="legend-item">
											<StatusIcon Status="@AgentRunStatus.Completed" />
											<div><strong>Completed:</strong> Agent finished execution successfully.</div>
										</div>
										<div class="legend-item">
											<StatusIcon Status="@AgentRunStatus.Failed" />
											<div><strong>Failed:</strong> Agent encountered an error or failed tests/reviews.</div>
										</div>
										<div class="legend-item">
											<StatusIcon Status="@AgentRunStatus.Blocked" />
											<div><strong>Blocked:</strong> Card is blocked by dependencies or issue threshold.</div>
										</div>
										<div class="legend-item">
											<StatusIcon Status="@AgentRunStatus.Stopped" />
											<div><strong>Stopped:</strong> Agent process was manually terminated.</div>
										</div>
										<div class="legend-item">
											<StatusIcon Status="null" />
											<div><strong>Idle:</strong> No agent task currently running or assigned.</div>
										</div>
									</div>
								}
							</div>
						</div>

						@if (IsFeature)
						{
							<div class="detail-group">
								<label>Requirements</label>
								<div class="detail-value text-block">@(string.IsNullOrWhiteSpace(Feature!.Requirements) ? "No requirements provided." : Feature.Requirements)</div>
							</div>
							<div class="detail-group">
								<label>Acceptance Criteria</label>
								<div class="detail-value text-block">@(string.IsNullOrWhiteSpace(Feature.AcceptanceCriteria) ? "No acceptance criteria specified." : Feature.AcceptanceCriteria)</div>
							</div>
							<div class="detail-group">
								<label>Suggested Solution</label>
								<div class="detail-value text-block">@(string.IsNullOrWhiteSpace(Feature.SuggestedSolution) ? "None specified." : Feature.SuggestedSolution)</div>
							</div>
						}
						else
						{
							<div class="detail-group">
								<label>Description</label>
								<div class="detail-value text-block">@(string.IsNullOrWhiteSpace(Step!.Description) ? "No description provided." : Step.Description)</div>
							</div>
							<div class="detail-group">
								<label>Guidance Notes</label>
								<div class="detail-value text-block">@(string.IsNullOrWhiteSpace(Step.GuidanceNotes) ? "No guidance notes." : Step.GuidanceNotes)</div>
							</div>
						}

						<div class="detail-grid">
							<div class="detail-item">
								<span class="detail-label">Branch Name:</span>
								<span class="detail-val">@(BranchName ?? "None")</span>
							</div>
							<div class="detail-item">
								<span class="detail-label">Worktree Path:</span>
								<span class="detail-val">@(WorktreePath ?? "None")</span>
							</div>
						</div>

						<div class="toggle-group">
							<label class="toggle-label">
								<input type="checkbox" checked="@AlwaysRequireHumanReview" @onchange="ToggleAlwaysRequireHumanReview" />
								<span>Always require human review (overrides board-level skip)</span>
							</label>
						</div>
					</div>
				}
				else if (activeTab == "moves")
				{
					<div class="tab-panel">
						<p class="tab-subtitle">Allowed column transitions according to workflow rules and dependency gating:</p>

						@if (IsAgentRunning)
						{
							<div class="alert alert-info">
								Card moves are hard-blocked while an agent is currently running. Stop the agent under <em>Manual Controls</em> if you need to move it.
							</div>
						}
						else if (MergeConflictPending)
						{
							<div class="alert alert-warning">
								Card has an unresolved merge conflict. Resolve the conflict and resume merge before moving.
								<div class="mt-2">
									<button class="btn btn-primary" @onclick="HandleResumeMerge">Resume Merge</button>
								</div>
							</div>
						}
						else if (allowedMoves.Count == 0)
						{
							<div class="alert alert-secondary">
								No transitions available from <strong>@CurrentColumn</strong>.
							</div>
						}
						else
						{
							<div class="moves-container">
								@foreach (var move in allowedMoves)
								{
									@if (move == WorkflowColumn.Backlog)
									{
										<div class="backlog-move-group">
											<span class="move-target-label">Move to Backlog:</span>
											<button class="btn btn-outline-warning" @onclick="() => ExecuteMove(move, discardWorktree: false)">
												Pause Worktree
											</button>
											<button class="btn btn-outline-danger" @onclick="() => ExecuteMove(move, discardWorktree: true)">
												Discard Worktree
											</button>
										</div>
									}
									else
									{
										<button class="btn btn-primary btn-move" @onclick="() => ExecuteMove(move, discardWorktree: false)">
											Move to @move
										</button>
									}
								}
							</div>
						}
					</div>
				}
				else if (activeTab == "controls")
				{
					<div class="tab-panel">
						<p class="tab-subtitle">Direct agent execution and worktree controls:</p>

						<div class="controls-list">
							<!-- Stop agent -->
							<div class="control-row">
								<div class="control-desc">
									<strong>Stop Agent Process</strong>
									<p>Terminates the active copilot CLI process and marks the run as Stopped.</p>
								</div>
								<button class="btn btn-danger" disabled="@(!IsAgentRunning)" @onclick="HandleStopAgent">
									Stop Agent
								</button>
							</div>

							<!-- Retry agent -->
							@if (!IsFeature && (CurrentColumn == WorkflowColumn.Build || CurrentColumn == WorkflowColumn.AgentReview))
							{
								<div class="control-row">
									<div class="control-desc">
										<strong>Retry / Restart Agent</strong>
										<p>Clears previous failed or stopped runs and requests execution anew.</p>
									</div>
									<button class="btn btn-warning" disabled="@IsAgentRunning" @onclick="HandleRetryAgent">
										Retry Agent
									</button>
								</div>
							}

							<!-- Discard uncommitted changes -->
							@if (!string.IsNullOrWhiteSpace(WorktreePath))
							{
								<div class="control-row">
									<div class="control-desc">
										<strong>Discard Uncommitted Changes</strong>
										<p>Removes all unstaged and uncommitted changes from the card's git worktree.</p>
									</div>
									<button class="btn btn-outline-danger" @onclick="HandleDiscardUncommitted">
										Discard Uncommitted Changes
									</button>
								</div>
							}

							<!-- Resume merge -->
							@if (MergeConflictPending)
							{
								<div class="control-row">
									<div class="control-desc">
										<strong>Resume Merge</strong>
										<p>Commits resolved merge conflicts and finalizes the transition to Done.</p>
									</div>
									<button class="btn btn-success" @onclick="HandleResumeMerge">
										Resume Merge
									</button>
								</div>
							}
						</div>
					</div>
				}
				else if (activeTab == "usage")
				{
					<div class="tab-panel">
						<div class="usage-stats-grid">
							<div class="usage-stat-card">
								<span class="usage-label">Agent Review Failures</span>
								<span class="usage-number text-danger">@AgentReviewFailCount</span>
							</div>
							<div class="usage-stat-card">
								<span class="usage-label">Human Review Failures</span>
								<span class="usage-number text-warning">@HumanReviewFailCount</span>
							</div>
							<div class="usage-stat-card">
								<span class="usage-label">Tokens Used</span>
								<span class="usage-number">@FormatTokens(TokensUsed)</span>
							</div>
							<div class="usage-stat-card">
								<span class="usage-label">Time Spent</span>
								<span class="usage-number">@FormatDuration(TimeSpent)</span>
							</div>
						</div>

						@if (qualitySignals != null)
						{
							<div class="quality-signals-box mt-3">
								<h5>Quality Signals</h5>
								<div class="signals-list">
									<div><strong>Total Review Failures:</strong> @qualitySignals.TotalReviewFailures</div>
									<div><strong>Churn Ratio:</strong> @qualitySignals.ChurnRatio.ToString("F2")</div>
									<div><strong>Is Rework:</strong> @(qualitySignals.IsRework ? "Yes" : "No")</div>
								</div>
							</div>
						}
					</div>
				}
				else if (activeTab == "comments")
				{
					<div class="tab-panel">
						<div class="comments-thread">
							@if (comments.Count == 0)
							{
								<p class="text-muted">No comments yet. Start a discussion below.</p>
							}
							else
							{
								@foreach (var c in comments)
								{
									<div class="comment-bubble">
										<div class="comment-meta">
											<span class="comment-author">@c.Author</span>
											<span class="comment-date">@c.CreatedAt.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</span>
										</div>
										<div class="comment-text">@c.Body</div>
									</div>
								}
							}
						</div>

						<div class="add-comment-box">
							<div class="input-row">
								<input class="form-control author-input" placeholder="Your name" @bind="newCommentAuthor" />
							</div>
							<div class="input-row mt-2">
								<textarea class="form-control" rows="3" placeholder="Write a comment..." @bind="newCommentBody"></textarea>
							</div>
							<div class="mt-2 text-end">
								<button class="btn btn-primary" @onclick="AddComment" disabled="@(string.IsNullOrWhiteSpace(newCommentBody))">
									Add Comment
								</button>
							</div>
						</div>
					</div>
				}
			</div>

			<footer class="popup-footer">
				<button class="btn btn-secondary" @onclick="Close">Close</button>
			</footer>
		}
	</div>
</div>

