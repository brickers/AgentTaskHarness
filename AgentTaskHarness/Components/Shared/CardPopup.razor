@using AgentTaskHarness.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject FeatureTransitionOrchestrator FeatureOrchestrator
@inject StepTransitionOrchestrator StepOrchestrator
@inject IAgentScheduler AgentScheduler
@inject ReviewOutcomeService ReviewOutcomeService
@inject UsageTrackingService UsageTrackingService
@inject CommentService CommentService
@inject FeatureDependencyService FeatureDependencyService

<div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-sm" @onclick="HandleBackdropClick">
    <div class="flex max-h-[90vh] w-full max-w-5xl flex-col overflow-hidden rounded-xl bg-white shadow-2xl" @onclick:stopPropagation="true">
        @if (Feature is null && Step is null)
        {
            <div class="p-6 text-slate-700">
                <p>No card selected.</p>
                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="Close">Close</button>
            </div>
        }
        else
        {
            <header class="flex items-start justify-between border-b-[3px] border-slate-200 bg-slate-50 px-6 py-4">
                <div class="min-w-0 flex-1">
                    <div class="mb-2 flex flex-wrap items-center gap-2">
						<span class="rounded-full px-2 py-1 text-xs font-semibold @(IsFeature ? "bg-indigo-100 text-indigo-700" : "bg-slate-200 text-slate-700")">
							@(IsFeature ? "Feature" : "Step")
						</span>
                        <span class="rounded-full bg-slate-200 px-2 py-1 text-xs font-semibold text-slate-700">@CurrentColumn</span>
                        <StatusIcon Status="@CurrentRun?.Status" ShowText="true"/>
                    </div>
                    <h2 class="truncate text-xl font-semibold text-slate-900">@CardTitle</h2>
                </div>
                <div class="ml-4 shrink-0">
                    <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" @onclick="Close" aria-label="Close popup">&times;</button>
                </div>
            </header>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="flex items-center justify-between gap-3 border-[3px] border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert">
                    @_errorMessage
                    <button type="button" class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" @onclick="() => _errorMessage = null">&times;</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="flex items-center justify-between gap-3 border-[3px] border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-700" role="alert">
                    @_successMessage
                    <button type="button" class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-200 bg-slate-100 px-2 py-1 text-xl leading-none text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" @onclick="() => _successMessage = null">&times;</button>
                </div>
            }

            <!-- Rework / Issue Alerts -->
            @if (IsRework)
            {
                <div class="border-[3px] border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
                    <strong>Rework in progress:</strong> This card was returned to Build after review failures.
                </div>
            }

            @if (HasThresholdIssue)
            {
                <div class="border-[3px] border-red-200 bg-red-50 p-3 text-sm text-red-700">
                    <strong>Issue threshold reached:</strong> Review failure counters reached the board limit. Agent
                    auto-start is suspended.
                </div>
            }

            @if (MergeConflictPending)
            {
                <div class="border-[3px] border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
                    <strong>Merge conflict pending:</strong> Worktree has git conflicts. Resolve them in the worktree
                    and click <em>Resume Merge</em>.
                </div>
            }

            <!-- Active Agent Session Alert -->
            @if (IsAgentRunning)
            {
                <div class="flex items-center gap-3 rounded-md border-[3px] border-blue-200 bg-blue-50 p-4 text-blue-900">
                    <StatusIcon Status="@CurrentRun?.Status" ShowText="true"/>
                    <div class="flex min-w-0 flex-1 items-center justify-between gap-3">
                        <span>Agent is currently active. Card cannot be moved while agent is running.</span>
                        @if (!string.IsNullOrWhiteSpace(CurrentRun?.SessionLink))
                        {
                            <a href="@CurrentRun.SessionLink" target="_blank" rel="noreferrer noopener"
                               class="shrink-0 rounded-md border-[3px] border-blue-300 bg-white px-3 py-2 text-sm font-medium text-blue-700 hover:bg-blue-100">
                                Open Agent Window &nearr;
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="flex flex-wrap gap-1 border-b-[3px] border-slate-200 bg-white px-6">
                <button class="border-b-2 border-transparent bg-slate-50 px-3 py-2 text-slate-600 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 @(_activeTab == "details" ? "active" : "")"
                        @onclick='() => _activeTab = "details"'>Details
                </button>
                @if (IsFeature)
                {
                    <button class="border-b-2 border-transparent bg-slate-50 px-3 py-2 text-slate-600 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 @(_activeTab == "dependencies" ? "active" : "")" @onclick='() => _activeTab = "dependencies"'>Dependencies</button>
                }
                <button class="border-b-2 border-transparent bg-slate-50 px-3 py-2 text-slate-600 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 @(_activeTab == "moves" ? "active" : "")" @onclick='() => _activeTab = "moves"'>
                    Available Moves
                </button>
                <button class="border-b-2 border-transparent bg-slate-50 px-3 py-2 text-slate-600 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 @(_activeTab == "controls" ? "active" : "")"
                        @onclick='() => _activeTab = "controls"'>Manual Controls
                </button>
                <button class="border-b-2 border-transparent bg-slate-50 px-3 py-2 text-slate-600 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 @(_activeTab == "usage" ? "active" : "")" @onclick='() => _activeTab = "usage"'>
                    Cost &amp; Quality
                </button>
                <button class="border-b-2 border-transparent bg-slate-50 px-3 py-2 text-slate-600 hover:border-slate-300 hover:bg-slate-100 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 @(_activeTab == "comments" ? "active" : "")"
                        @onclick='() => _activeTab = "comments"'>Comments (@_comments.Count)
                </button>
            </div>

            <div class="min-h-0 flex-1 overflow-y-auto p-6">
                @if (_activeTab == "details")
                {
                    <div class="space-y-4">
                        <!-- Status Indicator & Explanation Section -->
                        <div class="mb-6 overflow-hidden rounded-lg border-[3px] border-slate-200 bg-white shadow-sm">
                            <div class="flex flex-wrap items-center justify-between gap-3 border-b-[3px] border-slate-200 bg-slate-50 p-4">
                                <div class="flex items-center gap-2">
                                    <StatusIcon Status="@CurrentRun?.Status"/>
                                    <span class="font-semibold text-slate-800">
										<strong>Status:</strong> @(CurrentRun != null ? CurrentRun.Status.ToString() : "Idle")
									</span>
                                </div>
                                <span class="text-sm text-slate-600">
									@(CurrentRun != null
                                        ? StatusIcon.GetStatusDescription(CurrentRun.Status)
                                        : "No active agent run. Card is currently idle.")
								</span>
                            </div>

                            <div class="p-4">
                                <div class="flex cursor-pointer items-center justify-between font-medium text-slate-700" @onclick="() => _showStatusLegend = !_showStatusLegend">
                                    <span class="font-semibold">Status Indicator Legend</span>
                                    <span class="text-sm text-indigo-600">@(_showStatusLegend ? "Hide ▲" : "Show ▼")</span>
                                </div>
                                @if (_showStatusLegend)
                                {
                                    <div class="mt-3 grid gap-3 sm:grid-cols-2">
                                        <div class="flex items-start gap-2 rounded-md bg-slate-50 p-2 text-sm text-slate-600">
                                            <StatusIcon Status="@AgentRunStatus.Working"/>
                                            <div><strong>Working:</strong> Agent is actively executing tasks and
                                                modifying code.
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2 rounded-md bg-slate-50 p-2 text-sm text-slate-600">
                                            <StatusIcon Status="@AgentRunStatus.WaitingForInput"/>
                                            <div><strong>Waiting for input:</strong> Agent is paused waiting for user
                                                response.
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2 rounded-md bg-slate-50 p-2 text-sm text-slate-600">
                                            <StatusIcon Status="@AgentRunStatus.Queued"/>
                                            <div><strong>Queued:</strong> Scheduled and awaiting an available worker
                                                slot.
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2 rounded-md bg-slate-50 p-2 text-sm text-slate-600">
                                            <StatusIcon Status="@AgentRunStatus.Completed"/>
                                            <div><strong>Completed:</strong> Agent finished execution successfully.
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2 rounded-md bg-slate-50 p-2 text-sm text-slate-600">
                                            <StatusIcon Status="@AgentRunStatus.Failed"/>
                                            <div><strong>Failed:</strong> Agent encountered an error or failed
                                                tests/reviews.
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2 rounded-md bg-slate-50 p-2 text-sm text-slate-600">
                                            <StatusIcon Status="@AgentRunStatus.Blocked"/>
                                            <div><strong>Blocked:</strong> Card is blocked by dependencies or issue
                                                threshold.
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2 rounded-md bg-slate-50 p-2 text-sm text-slate-600">
                                            <StatusIcon Status="@AgentRunStatus.Stopped"/>
                                            <div><strong>Stopped:</strong> Agent process was manually terminated.</div>
                                        </div>
                                        <div class="flex items-start gap-2 rounded-md bg-slate-50 p-2 text-sm text-slate-600">
                                            <StatusIcon Status="null"/>
                                            <div><strong>Idle:</strong> No agent task currently running or assigned.
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (IsFeature)
                        {
                            <div class="mb-4 grid gap-2">
                                <label>Requirements</label>
                                <div
                                    class="whitespace-pre-wrap text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(Feature!.Requirements) ? "No requirements provided." : Feature.Requirements)</div>
                            </div>
                            <div class="mb-4 grid gap-2">
                                <label>Acceptance Criteria</label>
                                <div
                                    class="whitespace-pre-wrap text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(Feature.AcceptanceCriteria) ? "No acceptance criteria specified." : Feature.AcceptanceCriteria)</div>
                            </div>
                            <div class="mb-4 grid gap-2">
                                <label>Suggested Solution</label>
                                <div
                                    class="whitespace-pre-wrap text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(Feature.SuggestedSolution) ? "None specified." : Feature.SuggestedSolution)</div>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4 grid gap-2">
                                <label>Description</label>
                                <div
                                    class="whitespace-pre-wrap text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(Step!.Description) ? "No description provided." : Step.Description)</div>
                            </div>
                            <div class="mb-4 grid gap-2">
                                <label>Guidance Notes</label>
                                <div
                                    class="whitespace-pre-wrap text-sm leading-6 text-slate-600">@(string.IsNullOrWhiteSpace(Step.GuidanceNotes) ? "No guidance notes." : Step.GuidanceNotes)</div>
                            </div>
                        }

                        <div class="grid gap-3 sm:grid-cols-2">
                            <div class="grid gap-1 rounded-md bg-slate-50 p-3">
                                <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Branch Name:</span>
                                <span class="break-all text-sm text-slate-700">@(BranchName ?? "None")</span>
                            </div>
                            <div class="grid gap-1 rounded-md bg-slate-50 p-3">
                                <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Worktree Path:</span>
                                <span class="break-all text-sm text-slate-700">@(WorktreePath ?? "None")</span>
                            </div>
                        </div>

                        <div class="mt-4 rounded-md border-[3px] border-slate-200 bg-slate-50 p-3">
                            <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
                                <input type="checkbox" checked="@AlwaysRequireHumanReview"
                                       @onchange="ToggleAlwaysRequireHumanReview"/>
                                <span>Always require human review (overrides board-level skip)</span>
                            </label>
                        </div>
                    </div>
                }
                else if (_activeTab == "dependencies")
                {
                    <div class="space-y-4">
                        <p class="mb-4 text-sm text-slate-600">Prerequisites for this feature. Dependencies can only be changed while it is in Backlog.</p>
                        @if (_featureDependencies.Count == 0)
                        {
                            <p class="text-sm text-slate-500">No dependencies.</p>
                        }
                        else
                        {
                            <div class="grid gap-2">
                                @foreach (var dependency in _featureDependencies)
                                {
                                    <div class="flex items-center justify-between gap-2 rounded-md border-[3px] border-slate-200 bg-slate-50 p-2 text-sm"><span>@dependency.DependsOnFeature.Title</span><span class="text-xs text-slate-500">(@dependency.DependsOnFeature.WorkflowColumn)</span>
                                        @if (CurrentColumn == WorkflowColumn.Backlog)
                                        { <button class="inline-flex items-center justify-center rounded-md border-[3px] border-red-600 bg-red-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-red-700 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="() => RemoveFeatureDependency(dependency.DependsOnFeatureId)">&times;</button> }
                                    </div>
                                }
                            </div>
                        }
                        @if (CurrentColumn == WorkflowColumn.Backlog)
                        {
                            <div class="mt-3 flex items-center gap-2">
                                <select class="block min-w-0 flex-1 rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" @bind="_selectedDependencyId">
                                    <option value="">Select prerequisite...</option>
                                    @foreach (var candidate in _dependencyCandidates)
                                    { <option value="@candidate.Id">@candidate.Title (@candidate.WorkflowColumn)</option> }
                                </select>
                                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" disabled="@(_selectedDependencyId == Guid.Empty)" @onclick="AddFeatureDependency">Add</button>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "moves")
                {
                    <div class="space-y-4">
                        <p class="mb-4 text-sm text-slate-600">Allowed column transitions according to workflow rules and dependency
                            gating:</p>

                        @if (IsAgentRunning)
                        {
                            <div class="border-[3px] border-blue-200 bg-blue-50 p-3 text-sm text-blue-800">
                                Card moves are hard-blocked while an agent is currently running. Stop the agent under
                                <em>Manual Controls</em> if you need to move it.
                            </div>
                        }
                        else if (MergeConflictPending)
                        {
                            <div class="border-[3px] border-amber-200 bg-amber-50 p-3 text-sm text-amber-800">
                                Card has an unresolved merge conflict. Resolve the conflict and resume merge before
                                moving.
                                <div class="mt-2">
                                    <button class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="HandleResumeMerge">Resume Merge</button>
                                </div>
                            </div>
                        }
                        else if (_allowedMoves.Count == 0)
                        {
                            <div class="border-[3px] border-slate-200 bg-slate-50 p-3 text-sm text-slate-600">
                                No transitions available from <strong>@CurrentColumn</strong>.
                            </div>
                        }
                        else
                        {
                            <div class="flex flex-wrap items-center gap-2">
                                @foreach (var move in _allowedMoves)
                                {
                                    @if (move == WorkflowColumn.Backlog)
                                    {
                                        <div class="flex flex-wrap items-center gap-2">
                                            <span class="text-sm font-semibold text-slate-700">Move to Backlog:</span>
                                            <button class="inline-flex items-center justify-center rounded-md border-[3px] border-amber-500 bg-amber-500 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-amber-600 hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                                    @onclick="() => ExecuteMove(move, false)">
                                                Pause Worktree
                                            </button>
                                            <button class="inline-flex items-center justify-center rounded-md border-[3px] border-red-600 bg-red-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-red-700 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                                    @onclick="() => ExecuteMove(move, true)">
                                                Discard Worktree
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                                                @onclick="() => ExecuteMove(move, false)">
                                            Move to @move
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "controls")
                {
                    <div class="space-y-4">
                        <p class="mb-4 text-sm text-slate-600">Direct agent execution and worktree controls:</p>

                        <div class="grid gap-3">
                            <!-- Stop agent -->
                            <div class="flex items-center justify-between gap-4 rounded-md border-[3px] border-slate-200 p-3">
                                <div class="min-w-0 flex-1">
                                    <strong>Stop Agent Process</strong>
                                    <p>Terminates the active copilot CLI process and marks the run as Stopped.</p>
                                </div>
                                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-red-600 bg-red-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-red-700 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" disabled="@(!IsAgentRunning)" @onclick="HandleStopAgent">
                                    Stop Agent
                                </button>
                            </div>

                            <!-- Retry agent -->
                            @if (!IsFeature && (CurrentColumn == WorkflowColumn.Build || CurrentColumn == WorkflowColumn.AgentReview))
                            {
                                <div class="flex items-center justify-between gap-4 rounded-md border-[3px] border-slate-200 p-3">
                                    <div class="min-w-0 flex-1">
                                        <strong>Retry / Restart Agent</strong>
                                        <p>Clears previous failed or stopped runs and requests execution anew.</p>
                                    </div>
                                    <button class="inline-flex items-center justify-center rounded-md border-[3px] border-amber-500 bg-amber-500 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-amber-600 hover:bg-amber-600 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" disabled="@IsAgentRunning"
                                            @onclick="HandleRetryAgent">
                                        Retry Agent
                                    </button>
                                </div>
                            }

                            <!-- Discard uncommitted changes -->
                            @if (!string.IsNullOrWhiteSpace(WorktreePath))
                            {
                                <div class="flex items-center justify-between gap-4 rounded-md border-[3px] border-slate-200 p-3">
                                    <div class="min-w-0 flex-1">
                                        <strong>Discard Uncommitted Changes</strong>
                                        <p>Removes all unstaged and uncommitted changes from the card's git
                                            worktree.</p>
                                    </div>
                                    <button class="inline-flex items-center justify-center rounded-md border-[3px] border-red-600 bg-red-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-red-700 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="HandleDiscardUncommitted">
                                        Discard Uncommitted Changes
                                    </button>
                                </div>
                            }

                            <!-- Resume merge -->
                            @if (MergeConflictPending)
                            {
                                <div class="flex items-center justify-between gap-4 rounded-md border-[3px] border-slate-200 p-3">
                                    <div class="min-w-0 flex-1">
                                        <strong>Resume Merge</strong>
                                        <p>Commits resolved merge conflicts and finalizes the transition to Done.</p>
                                    </div>
                                    <button class="inline-flex items-center justify-center rounded-md border-[3px] border-emerald-600 bg-emerald-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-emerald-700 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="HandleResumeMerge">
                                        Resume Merge
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (_activeTab == "usage")
                {
                    <div class="space-y-4">
                        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                            <div class="grid gap-1 rounded-lg border-[3px] border-slate-200 bg-slate-50 p-4">
                                <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Agent Review Failures</span>
                                <span class="text-2xl font-bold text-red-600">@AgentReviewFailCount</span>
                            </div>
                            <div class="grid gap-1 rounded-lg border-[3px] border-slate-200 bg-slate-50 p-4">
                                <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Human Review Failures</span>
                                <span class="text-2xl font-bold text-amber-600">@HumanReviewFailCount</span>
                            </div>
                            <div class="grid gap-1 rounded-lg border-[3px] border-slate-200 bg-slate-50 p-4">
                                <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Tokens Used</span>
                                <span class="text-2xl font-bold text-slate-800">@FormatTokens(TokensUsed)</span>
                            </div>
                            <div class="grid gap-1 rounded-lg border-[3px] border-slate-200 bg-slate-50 p-4">
                                <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Time Spent</span>
                                <span class="text-2xl font-bold text-slate-800">@FormatDuration(TimeSpent)</span>
                            </div>
                        </div>

                        @if (_qualitySignals != null)
                        {
                            <div class="mt-3 rounded-lg border-[3px] border-slate-200 bg-slate-50 p-4">
                                <h5>Quality Signals</h5>
                                <div class="grid gap-2 text-sm text-slate-700">
                                    <div><strong>Total Review Failures:</strong> @_qualitySignals.TotalReviewFailures
                                    </div>
                                    <div><strong>Churn Ratio:</strong> @_qualitySignals.ChurnRatio.ToString("F2")</div>
                                    <div><strong>Is Rework:</strong> @(_qualitySignals.IsRework ? "Yes" : "No")</div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_activeTab == "comments")
                {
                    <div class="space-y-4">
                        <div class="grid gap-3">
                            @if (_comments.Count == 0)
                            {
                            <p class="text-sm text-slate-500">No comments yet. Start a discussion below.</p>
                            }
                            else
                            {
                                @foreach (var c in _comments)
                                {
                                    <div class="rounded-lg border-[3px] border-slate-200 bg-slate-50 p-3">
                                        <div class="mb-1 flex items-center justify-between gap-2 text-xs text-slate-500">
                                            <span class="font-semibold text-slate-700">@c.Author</span>
                                            <span
                                                >@c.CreatedAt.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</span>
                                        </div>
                                        <div class="whitespace-pre-wrap text-sm leading-6 text-slate-700">@c.Body</div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="mt-4 rounded-lg border-[3px] border-slate-200 bg-slate-50 p-4">
                            <div>
                                <input class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" placeholder="Your name"
                                       @bind="_newCommentAuthor"/>
                            </div>
                            <div class="mt-2">
                                <textarea class="mt-1 block w-full rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" rows="3" placeholder="Write a comment..."
                                          @bind="_newCommentBody"></textarea>
                            </div>
                            <div class="mt-2 text-end">
                                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-indigo-600 bg-indigo-600 px-3 py-2 text-sm font-medium text-white transition-colors hover:border-indigo-700 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="AddComment"
                                        disabled="@(string.IsNullOrWhiteSpace(_newCommentBody))">
                                    Add Comment
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <footer class="flex justify-end border-t border-slate-200 bg-slate-50 px-6 py-4">
                <button class="inline-flex items-center justify-center rounded-md border-[3px] border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50" @onclick="Close">Close</button>
            </footer>
        }
    </div>
</div>

@code {
    [Parameter] public Feature? Feature { get; set; }
    [Parameter] public Step? Step { get; set; }
    [Parameter] public Board? Board { get; set; }
    [Parameter] public AgentRun? CurrentRun { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string _activeTab = "details";
    private bool _showStatusLegend = true;
    private string? _errorMessage;
    private string? _successMessage;
    private List<WorkflowColumn> _allowedMoves = [];
    private List<Comment> _comments = [];
    private List<FeatureDependency> _featureDependencies = [];
    private List<Feature> _dependencyCandidates = [];
    private Guid _selectedDependencyId;
    private QualitySignals? _qualitySignals;
    private string _newCommentAuthor = "User";
    private string _newCommentBody = "";

    private bool IsFeature => Feature != null;
    private Guid CardId => IsFeature ? Feature!.Id : Step!.Id;
    private CardType CardTypeEnum => IsFeature ? CardType.Feature : CardType.Step;
    private string CardTitle => IsFeature ? Feature!.Title : Step!.Title;
    private WorkflowColumn CurrentColumn => IsFeature ? Feature!.WorkflowColumn : Step!.WorkflowColumn;
    private string? BranchName => IsFeature ? Feature!.BranchName : Step!.BranchName;
    private string? WorktreePath => IsFeature ? Feature!.WorktreePath : Step!.WorktreePath;
    private bool AlwaysRequireHumanReview => IsFeature ? Feature!.AlwaysRequireHumanReview : Step!.AlwaysRequireHumanReview;
    private int AgentReviewFailCount => IsFeature ? Feature!.AgentReviewFailCount : Step!.AgentReviewFailCount;
    private int HumanReviewFailCount => IsFeature ? Feature!.HumanReviewFailCount : Step!.HumanReviewFailCount;
    private long TokensUsed => IsFeature ? _featureSummary?.TotalTokensUsed ?? 0 : Step!.TokensUsed;
    private TimeSpan TimeSpent => IsFeature ? _featureSummary?.TotalTimeSpent ?? TimeSpan.Zero : Step!.TimeSpent;
    private bool MergeConflictPending => IsFeature ? Feature!.MergeConflictPending : Step!.MergeConflictPending;

    private FeatureUsageSummary? _featureSummary;

    private bool IsAgentRunning =>
        CurrentRun?.Status == AgentRunStatus.Working || CurrentRun?.Status == AgentRunStatus.WaitingForInput;

    private bool IsRework =>
        CurrentColumn == WorkflowColumn.Build &&
        (IsFeature ? ReviewOutcomeService.IsRework(Feature!) : ReviewOutcomeService.IsRework(Step!));

    private bool HasThresholdIssue =>
        Board != null &&
        (IsFeature ? ReviewOutcomeService.HasIssue(Feature!, Board) : ReviewOutcomeService.HasIssue(Step!, Board));

    protected override async Task OnParametersSetAsync()
    {
        await RefreshDataAsync();
    }

    private async Task RefreshDataAsync()
    {
        _errorMessage = null;
        if (Feature == null && Step == null) return;

        try
        {
            // Load allowed moves
            if (IsFeature)
            {
                _featureDependencies = await FeatureDependencyService.GetForFeatureAsync(Feature!.Id);
                var existingIds = _featureDependencies.Select(d => d.DependsOnFeatureId).ToHashSet();
                _dependencyCandidates = await DbContext.Features.AsNoTracking()
                    .Where(f => f.BoardId == Feature.BoardId && f.Id != Feature.Id && !existingIds.Contains(f.Id))
                    .OrderBy(f => f.Title).ToListAsync();
                var moves = await FeatureOrchestrator.GetAllowedMovesAsync(Feature!.Id);
                _allowedMoves = moves.ToList();
                _featureSummary = await UsageTrackingService.GetFeatureSummaryAsync(Feature.Id);
                _qualitySignals = await UsageTrackingService.GetQualitySignalsAsync(Feature.Id);
            }
            else
            {
                var moves = await StepOrchestrator.GetAllowedMovesAsync(Step!.Id);
                _allowedMoves = moves.ToList();
            }

            // Load comments
            var loadedComments = await CommentService.GetCommentsAsync(CardTypeEnum, CardId);
            _comments = loadedComments.ToList();

            // Load active run
            CurrentRun = await AgentScheduler.GetCurrentRunAsync(CardTypeEnum, CardId);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ExecuteMove(WorkflowColumn targetColumn, bool discardWorktree)
    {
        _errorMessage = null;
        _successMessage = null;
        try
        {
            if (IsFeature)
            {
                await FeatureOrchestrator.MoveAsync(Feature!.Id, targetColumn, discardWorktree);
            }
            else
            {
                await StepOrchestrator.MoveAsync(Step!.Id, targetColumn, discardWorktree);
            }

            _successMessage = $"Moved successfully to {targetColumn}.";
            await OnChanged.InvokeAsync();
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleStopAgent()
    {
        _errorMessage = null;
        try
        {
            await AgentScheduler.StopAgentAsync(CardTypeEnum, CardId);
            _successMessage = "Agent stopped.";
            await OnChanged.InvokeAsync();
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleRetryAgent()
    {
        _errorMessage = null;
        try
        {
            if (!IsFeature)
            {
                await AgentScheduler.RetryAgentAsync(Step!.Id);
                _successMessage = "Agent restarted.";
                await OnChanged.InvokeAsync();
                await RefreshDataAsync();
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleDiscardUncommitted()
    {
        _errorMessage = null;
        try
        {
            if (IsFeature)
            {
                await FeatureOrchestrator.DiscardUncommittedChangesAsync(Feature!.Id);
            }
            else
            {
                await StepOrchestrator.DiscardUncommittedChangesAsync(Step!.Id);
            }

            _successMessage = "Uncommitted changes discarded.";
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task HandleResumeMerge()
    {
        _errorMessage = null;
        try
        {
            if (IsFeature)
            {
                await FeatureOrchestrator.ResumeMergeAsync(Feature!.Id);
            }
            else
            {
                await StepOrchestrator.ResumeMergeAsync(Step!.Id);
            }

            _successMessage = "Merge resumed and finalized to Done.";
            await OnChanged.InvokeAsync();
            await RefreshDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task ToggleAlwaysRequireHumanReview(ChangeEventArgs e)
    {
        var value = e.Value is bool b && b;
        if (IsFeature)
        {
            Feature!.AlwaysRequireHumanReview = value;
        }
        else
        {
            Step!.AlwaysRequireHumanReview = value;
        }

        await DbContext.SaveChangesAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task AddFeatureDependency()
    {
        if (!IsFeature || _selectedDependencyId == Guid.Empty) return;
        try
        {
            await FeatureDependencyService.AddAsync(Feature!.Id, _selectedDependencyId);
            _selectedDependencyId = Guid.Empty;
            _successMessage = "Dependency added.";
            await RefreshDataAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
    }

    private async Task RemoveFeatureDependency(Guid dependencyId)
    {
        if (!IsFeature) return;
        try
        {
            await FeatureDependencyService.RemoveAsync(Feature!.Id, dependencyId);
            _successMessage = "Dependency removed.";
            await RefreshDataAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) { _errorMessage = ex.Message; }
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(_newCommentBody)) return;

        try
        {
            await CommentService.AddCommentAsync(CardTypeEnum, CardId, _newCommentAuthor, _newCommentBody);
            _newCommentBody = "";
            var loadedComments = await CommentService.GetCommentsAsync(CardTypeEnum, CardId);
            _comments = loadedComments.ToList();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await Close();
    }

    private static string FormatTokens(long tokens)
    {
        return tokens switch
        {
            >= 1_000_000 => $"{tokens / 1_000_000.0:F1}M",
            >= 1_000 => $"{tokens / 1_000.0:F1}k",
            _ => tokens.ToString()
        };
    }

    private static string FormatDuration(TimeSpan ts)
    {
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}h {ts.Minutes}m"
            : ts.TotalMinutes >= 1
                ? $"{ts.Minutes}m {ts.Seconds}s"
                : $"{ts.Seconds}s";
    }

}
