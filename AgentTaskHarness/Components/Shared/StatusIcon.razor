<span class="inline-flex items-center gap-1.5 align-middle @(IsMini ? "text-[8px]" : "text-xs")" title="@TooltipText">
	@if (Status == AgentRunStatus.Working)
    {
        <span class="relative inline-flex h-3 w-3 items-center justify-center rounded-full text-green-500" aria-label="Agent Working">
			<span class="absolute inset-0 animate-ping rounded-full bg-green-400 opacity-75"></span>
			<span class="inline-block h-full w-full rounded-full bg-green-500"></span>
		</span>
    }
    else if (Status == AgentRunStatus.WaitingForInput)
    {
        <span class="relative inline-flex h-3 w-3 items-center justify-center rounded-full" aria-label="Agent Waiting for Input">
			<span class="absolute inset-0 animate-pulse rounded-full bg-amber-400 opacity-60"></span>
			<span class="inline-block h-full w-full rounded-full bg-amber-500"></span>
		</span>
    }
    else if (Status == AgentRunStatus.Completed)
    {
        <span class="relative inline-flex h-3 w-3 items-center justify-center rounded-full" aria-label="Agent Completed">
			<span class="inline-block h-full w-full rounded-full bg-emerald-500"></span>
		</span>
    }
    else if (Status == AgentRunStatus.Failed)
    {
        <span class="relative inline-flex h-3 w-3 items-center justify-center rounded-full" aria-label="Agent Failed">
			<span class="inline-block h-full w-full rounded-full bg-red-500"></span>
		</span>
    }
    else if (Status == AgentRunStatus.Blocked)
    {
        <span class="relative inline-flex h-3 w-3 items-center justify-center rounded-full" aria-label="Agent Blocked">
			<span class="inline-block h-full w-full rounded-full bg-indigo-500"></span>
		</span>
    }
    else if (Status == AgentRunStatus.Stopped)
    {
        <span class="relative inline-flex h-3 w-3 items-center justify-center rounded-full" aria-label="Agent Stopped">
			<span class="inline-block h-full w-full rounded-full bg-slate-500"></span>
		</span>
    }
    else if (Status == AgentRunStatus.Queued)
    {
        <span class="relative inline-flex h-3 w-3 items-center justify-center rounded-full" aria-label="Agent Queued">
			<span class="inline-block h-full w-full rounded-full bg-blue-500"></span>
		</span>
    }
    else
    {
        <span class="relative inline-flex h-3 w-3 items-center justify-center rounded-full" aria-label="Idle">
			<span class="inline-block h-full w-full rounded-full bg-slate-300"></span>
		</span>
    }

    @if (!IsMini && ShowText)
    {
        <span class="text-xs font-medium text-slate-600">@(Status.HasValue ? FormatStatus(Status.Value) : "Idle")</span>
    }
</span>

@code {
    [Parameter] public AgentRunStatus? Status { get; set; }
    [Parameter] public bool IsMini { get; set; }
    [Parameter] public bool ShowText { get; set; }
    [Parameter] public string? Label { get; set; }

    private string TooltipText =>
        !string.IsNullOrWhiteSpace(Label)
            ? Label
            : Status.HasValue
                ? $"{FormatStatus(Status.Value)}: {GetStatusDescription(Status.Value)}"
                : "Idle / No Agent: Card has no active agent task assigned or running";

    public static string FormatStatus(AgentRunStatus status)
    {
        return status switch
        {
            AgentRunStatus.Working => "Working",
            AgentRunStatus.WaitingForInput => "Waiting for input",
            AgentRunStatus.Completed => "Completed",
            AgentRunStatus.Failed => "Failed",
            AgentRunStatus.Blocked => "Blocked",
            AgentRunStatus.Stopped => "Stopped",
            AgentRunStatus.Queued => "Queued",
            _ => status.ToString()
        };
    }

    public static string GetStatusDescription(AgentRunStatus status)
    {
        return status switch
        {
            AgentRunStatus.Working => "Agent is actively running and modifying code",
            AgentRunStatus.WaitingForInput => "Agent is waiting for user response or clarification",
            AgentRunStatus.Queued => "Queued and waiting for an available agent worker slot",
            AgentRunStatus.Completed => "Agent execution completed successfully",
            AgentRunStatus.Failed => "Agent execution failed or encountered errors",
            AgentRunStatus.Blocked => "Blocked by unmet prerequisites or review failure threshold",
            AgentRunStatus.Stopped => "Agent execution was manually halted",
            _ => "Idle / No active agent"
        };
    }

}
