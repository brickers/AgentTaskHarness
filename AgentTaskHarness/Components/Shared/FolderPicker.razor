@inject IJSRuntime Js

<button class="folder-picker" type="button" @onclick="ChooseAsync">Choose folder</button>

@code {
    [Parameter][EditorRequired] public EventCallback<string> OnFolderSelected { get; set; }

    private async Task ChooseAsync()
    {
        var folderName = await Js.InvokeAsync<string?>("directoryPicker.choose");
        if (!string.IsNullOrWhiteSpace(folderName))
        {
            await OnFolderSelected.InvokeAsync(folderName);
        }
    }

}