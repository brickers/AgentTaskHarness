@inherits LayoutComponentBase

<header class="border-b-[3px] border-slate-200 pb-6">
    <div class="flex flex-wrap items-center justify-between gap-6">
        <AppBreadcrumb/>
        <NavMenu/>
    </div>
</header>

@Body

<div id="blazor-error-ui" class="hidden fixed inset-x-0 bottom-0 z-50 bg-amber-100 px-4 py-3 text-amber-900 shadow-[0_-1px_2px_rgb(0_0_0_/_20%)]" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss absolute right-3 top-2 cursor-pointer">🗙</span>
</div>
